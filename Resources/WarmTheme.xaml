<!-- ============================================================================
     WarmTheme.xaml —— 官网暖色高级版的 WPF 试点 token（仅样式画廊使用）
     只加 W 前缀的新 key，不覆盖 BTheme / 旧设计系统；主窗未引用。
     ============================================================================ -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── 颜色 ───────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="WPaperBrush" Color="#FAF7F2"/>
    <SolidColorBrush x:Key="WPaperSoftBrush" Color="#F5EEE4"/>
    <SolidColorBrush x:Key="WSurfaceBrush" Color="#FFFCF7"/>
    <SolidColorBrush x:Key="WSurfaceRaisedBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="WInkBrush" Color="#2D2A26"/>
    <SolidColorBrush x:Key="WInkStrongBrush" Color="#1F1B17"/>
    <SolidColorBrush x:Key="WMutedBrush" Color="#665C52"/>
    <SolidColorBrush x:Key="WSubtleBrush" Color="#8A8074"/>
    <SolidColorBrush x:Key="WBorderBrush" Color="#E6DDD0"/>
    <SolidColorBrush x:Key="WBorderStrongBrush" Color="#D6C9B8"/>
    <SolidColorBrush x:Key="WCoralBrush" Color="#E07A5F"/>
    <SolidColorBrush x:Key="WCoralStrongBrush" Color="#B4533C"/>
    <SolidColorBrush x:Key="WCoralSoftBrush" Color="#FBEDE6"/>
    <SolidColorBrush x:Key="WGreenBrush" Color="#047857"/>
    <SolidColorBrush x:Key="WGreenStrongBrush" Color="#17694F"/>
    <SolidColorBrush x:Key="WGreenSoftBrush" Color="#E7F6F0"/>
    <SolidColorBrush x:Key="WAmberBrush" Color="#F4A261"/>
    <SolidColorBrush x:Key="WAmberStrongBrush" Color="#A45A0B"/>
    <SolidColorBrush x:Key="WAmberSoftBrush" Color="#FDF1E4"/>
    <SolidColorBrush x:Key="WBlueBrush" Color="#5B8DB8"/>
    <SolidColorBrush x:Key="WBlueStrongBrush" Color="#3B6E8F"/>
    <SolidColorBrush x:Key="WBlueSoftBrush" Color="#EAF2F8"/>
    <SolidColorBrush x:Key="WTealBrush" Color="#2A9D8F"/>
    <SolidColorBrush x:Key="WTealSoftBrush" Color="#E6F3F1"/>
    <SolidColorBrush x:Key="WRoseStrongBrush" Color="#A65E6D"/>
    <SolidColorBrush x:Key="WRoseSoftBrush" Color="#F6EAEA"/>

    <!-- ── 字体：标题用系统 Noto Serif SC，正文雅黑，数字等宽 ──── -->
    <FontFamily x:Key="WFontDisplay">Noto Serif SC, Source Han Serif SC, SimSun</FontFamily>
    <FontFamily x:Key="WFontBody">Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="WFontMono">Cascadia Mono, Consolas, Segoe UI</FontFamily>

    <!-- ── 圆角 ───────────────────────────────────────────────── -->
    <CornerRadius x:Key="WRadiusCard">12</CornerRadius>
    <CornerRadius x:Key="WRadiusInput">8</CornerRadius>

    <!-- ── FocusVisual ────────────────────────────────────────── -->
    <Style x:Key="WFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{StaticResource WGreenBrush}"
                            BorderThickness="2"
                            CornerRadius="999"
                            Margin="2"
                            SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 文本层级 ───────────────────────────────────────────── -->
    <Style x:Key="WHeroTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource WFontDisplay}"/>
        <Setter Property="FontSize" Value="40"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource WInkStrongBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="WSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource WFontDisplay}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource WInkStrongBrush}"/>
    </Style>

    <Style x:Key="WCardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource WFontBody}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource WInkStrongBrush}"/>
    </Style>

    <Style x:Key="WLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource WFontBody}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource WMutedBrush}"/>
    </Style>

    <Style x:Key="WBodyStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource WFontBody}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Foreground" Value="{StaticResource WMutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="22"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    </Style>

    <Style x:Key="WMonoSmallStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource WFontMono}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource WSubtleBrush}"/>
    </Style>

    <Style x:Key="WHeroNumberStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource WFontMono}"/>
        <Setter Property="FontSize" Value="54"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource WInkStrongBrush}"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>

    <Style x:Key="WNumberStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource WFontMono}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource WInkStrongBrush}"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>

    <!-- ── 卡片 / 首屏暖色带 ──────────────────────────────────── -->
    <Style x:Key="WCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource WBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource WRadiusCard}"/>
        <Setter Property="Padding" Value="22"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270"
                                  Opacity="0.08" Color="#5A3C28"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WHeroBandStyle" TargetType="Border">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#38E07A5F" Offset="0"/>
                    <GradientStop Color="#22F4A261" Offset="0.38"/>
                    <GradientStop Color="#16047857" Offset="0.68"/>
                    <GradientStop Color="#195B8DB8" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="{StaticResource WBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="18"/>
    </Style>

    <Style x:Key="WIconTileStyle" TargetType="Border">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Background" Value="{StaticResource WCoralSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource WCoralBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style x:Key="WStatusPillStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WGreenSoftBrush}"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Padding" Value="10,4"/>
    </Style>

    <Style x:Key="WColorChipStyle" TargetType="Border">
        <Setter Property="Width" Value="118"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderBrush" Value="{StaticResource WBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- ── 按钮 ───────────────────────────────────────────────── -->
    <Style x:Key="WButtonBaseStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource WFontBody}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="18,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource WFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="999"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource WButtonBaseStyle}">
        <Setter Property="Background" Value="{StaticResource WGreenStrongBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource WGreenStrongBrush}"/>
        <Setter Property="Foreground" Value="#FFFCF7"/>
    </Style>

    <Style x:Key="WGhostButtonStyle" TargetType="Button" BasedOn="{StaticResource WButtonBaseStyle}">
        <Setter Property="Background" Value="{StaticResource WSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource WBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource WInkBrush}"/>
    </Style>

    <Style x:Key="WCoralButtonStyle" TargetType="Button" BasedOn="{StaticResource WButtonBaseStyle}">
        <Setter Property="Background" Value="{StaticResource WCoralStrongBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource WCoralStrongBrush}"/>
        <Setter Property="Foreground" Value="#FFFCF7"/>
    </Style>

    <!-- ── 输入框 ─────────────────────────────────────────────── -->
    <Style x:Key="WTextBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontFamily" Value="{StaticResource WFontBody}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource WInkBrush}"/>
        <Setter Property="Background" Value="{StaticResource WSurfaceRaisedBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource WBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource WFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource WRadiusInput}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource WGreenBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════
         主窗 Warm Dashboard
         ══════════════════════════════════════════════════════════ -->

    <LinearGradientBrush x:Key="WWindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FAF7F2" Offset="0"/>
        <GradientStop Color="#F7F0E6" Offset="0.45"/>
        <GradientStop Color="#FAF7F2" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="WBrandGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#E07A5F" Offset="0"/>
        <GradientStop Color="#F4A261" Offset="0.36"/>
        <GradientStop Color="#047857" Offset="0.70"/>
        <GradientStop Color="#5B8DB8" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="WProgressGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#F4A261" Offset="0"/>
        <GradientStop Color="#E07A5F" Offset="0.45"/>
        <GradientStop Color="#047857" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="WMuyuCardBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FDF1E4" Offset="0"/>
        <GradientStop Color="#FBEDE6" Offset="0.55"/>
        <GradientStop Color="#FFFCF7" Offset="1"/>
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="WHeroGlowCoralBrush" Center="0.08,0" GradientOrigin="0.08,0"
                         RadiusX="0.75" RadiusY="0.9">
        <GradientStop Color="#33E07A5F" Offset="0"/>
        <GradientStop Color="#00E07A5F" Offset="0.72"/>
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="WHeroGlowGreenBrush" Center="0.92,0.9" GradientOrigin="0.92,0.9"
                         RadiusX="0.8" RadiusY="1">
        <GradientStop Color="#26047857" Offset="0"/>
        <GradientStop Color="#00047857" Offset="0.70"/>
    </RadialGradientBrush>

    <Style x:Key="WHeroCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource WBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="26" ShadowDepth="3" Direction="270"
                                  Opacity="0.10" Color="#5A3C28"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WPanelCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource WBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="18"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Direction="270"
                                  Opacity="0.07" Color="#5A3C28"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WStatCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource WBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="20,18"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Direction="270"
                                  Opacity="0.07" Color="#5A3C28"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WPanelTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource WFontDisplay}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource WInkStrongBrush}"/>
    </Style>

    <Style x:Key="WLiveAmountStyle" TargetType="TextBlock" BasedOn="{StaticResource WHeroNumberStyle}">
        <Setter Property="FontSize" Value="72"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource WGreenBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsPulse}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             To="0.62" Duration="0:0:0.09" AutoReverse="True"/>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="WStatLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource WFontBody}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource WMutedBrush}"/>
    </Style>

    <Style x:Key="WStatValueStyle" TargetType="TextBlock" BasedOn="{StaticResource WNumberStyle}">
        <Setter Property="FontSize" Value="38"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style x:Key="WStatHintStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource WFontMono}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource WSubtleBrush}"/>
    </Style>

    <Style x:Key="WDetailLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource WFontBody}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource WMutedBrush}"/>
    </Style>

    <Style x:Key="WDetailValueStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource WFontMono}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource WInkBrush}"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>

    <Style x:Key="WCountdownStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource WFontMono}"/>
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource WBlueStrongBrush}"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style x:Key="WLiveHintStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource WFontMono}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{StaticResource WMutedBrush}"/>
    </Style>

    <Style x:Key="WTopButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource WInkBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource WFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="999"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource WPaperSoftBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource WBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WLiveDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="6"/>
        <Setter Property="Height" Value="6"/>
        <Setter Property="Fill" Value="{StaticResource WGreenBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="1" To="0.25" Duration="0:0:0.9"
                                         AutoReverse="True" RepeatBehavior="Forever"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="WStatusDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="7"/>
        <Setter Property="Height" Value="7"/>
        <Setter Property="Fill" Value="{StaticResource WMutedBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="Earning">
                <Setter Property="Fill" Value="{StaticResource WGreenBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="LunchBreak">
                <Setter Property="Fill" Value="{StaticResource WAmberBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="ForcedRest">
                <Setter Property="Fill" Value="{StaticResource WAmberBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="OffWork">
                <Setter Property="Fill" Value="{StaticResource WSubtleBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="WNeutralPillStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WSurfaceRaisedBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource WBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Padding" Value="10,4"/>
    </Style>

    <Style x:Key="WMuyuButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource WFontBody}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource WInkBrush}"/>
        <Setter Property="Background" Value="{StaticResource WSurfaceRaisedBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource WAmberBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource WFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="999" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource WAmberSoftBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="8"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{StaticResource WPaperSoftBrush}"
                                CornerRadius="4"/>
                        <Border x:Name="PART_Indicator" Background="{StaticResource WProgressGradientBrush}"
                                CornerRadius="4" HorizontalAlignment="Left"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
