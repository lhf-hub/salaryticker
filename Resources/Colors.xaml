<!-- ============================================================================
     Colors.xaml —— 设计系统第一层：颜色 Token（暖阳浅色主题 · Claude 设计语言）
     风格：奶油白底 + 珊瑚橘主色 + 薄荷绿金额，柔和阴影、大圆角、简约而愉悦
     规则：所有页面/样式只允许引用这里的 Key，禁止硬编码色值
     ============================================================================ -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══════════ 背景层 ══════════ -->

    <!-- 页面背景：奶油白（非纯白，护眼） -->
    <SolidColorBrush x:Key="BgPageBrush" Color="#FAF7F2"/>
    <!-- 次级背景：略深的米色（提示条/分组底） -->
    <SolidColorBrush x:Key="BgSubtleBrush" Color="#F3EEE6"/>
    <!-- 卡片背景：纯白 -->
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <!-- 卡片悬浮：暖白 -->
    <SolidColorBrush x:Key="CardHoverBrush" Color="#FFFBF7"/>
    <!-- 输入框背景 -->
    <SolidColorBrush x:Key="InputBgBrush" Color="#FFFFFF"/>

    <!-- ══════════ 品牌色 ══════════ -->

    <!-- 主色：珊瑚橘（按钮/强调/品牌） -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#E07A5F"/>
    <!-- 主色高亮：悬停/脉冲 -->
    <SolidColorBrush x:Key="PrimaryBrightBrush" Color="#EE8A6D"/>
    <!-- 主色浅底：选中态/标签底 -->
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="#FBE9E2"/>
    <!-- 主色按钮上的文字 -->
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="#FFFFFF"/>

    <!-- ══════════ 金额色（薄荷绿） ══════════ -->

    <!-- 金额主色：深薄荷绿（大数字，白底可读） -->
    <SolidColorBrush x:Key="MoneyBrush" Color="#059669"/>
    <!-- 金额高亮：脉冲动画用 -->
    <SolidColorBrush x:Key="MoneyBrightBrush" Color="#10B981"/>
    <!-- 金额浅底 -->
    <SolidColorBrush x:Key="MoneySoftBrush" Color="#E7F6F0"/>

    <!-- ══════════ 功能色 ══════════ -->

    <!-- 信息：柔和蓝（少量使用，不喧宾夺主） -->
    <SolidColorBrush x:Key="InfoBrush" Color="#5B8DB8"/>
    <SolidColorBrush x:Key="InfoSoftBrush" Color="#EAF2F8"/>
    <!-- 摸鱼：蜜桃橙 -->
    <SolidColorBrush x:Key="WarnBrush" Color="#F4A261"/>
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#FDF1E4"/>
    <!-- 危险：陶土红 -->
    <SolidColorBrush x:Key="DangerBrush" Color="#E76F51"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FCEAE4"/>

    <!-- ══════════ 文字 ══════════ -->

    <!-- 主文字：暖黑（不用纯黑，更柔和） -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#2D2A26"/>
    <!-- 次要文字：暖灰 -->
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#7D7469"/>
    <!-- 禁用文字 -->
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#C4BBB0"/>
    <!-- 边框：暖色浅线 -->
    <SolidColorBrush x:Key="BorderLineBrush" Color="#EDE6DC"/>

    <!-- ══════════ 特殊用途 ══════════ -->

    <!-- 对话框遮罩 -->
    <SolidColorBrush x:Key="OverlayBrush" Color="#33000000"/>
    <!-- 迷你悬浮窗背景（半透明白） -->
    <SolidColorBrush x:Key="MiniBgBrush" Color="#F0FFFDFA"/>

    <!-- 进度条渐变：蜜桃橙 → 暖黄 → 薄荷绿 -->
    <LinearGradientBrush x:Key="ProgressGradientBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#F4A261" Offset="0"/>
        <GradientStop Color="#E9C46A" Offset="0.45"/>
        <GradientStop Color="#10B981" Offset="1"/>
    </LinearGradientBrush>

    <!-- 卡片阴影颜色（浅色主题用暖灰阴影，比纯黑自然） -->
    <Color x:Key="ShadowColor">#8A7A6A</Color>

</ResourceDictionary>
