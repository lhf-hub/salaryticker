<!-- ============================================================================
     Controls.xaml —— 设计系统第三层：复合控件样式（卡片 / 文本 / 数字）
     暖阳浅色风格：卡片大圆角 24 + 柔和暖灰阴影 + 金额薄荷绿
     ============================================================================ -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ══════════ 卡片样式 ══════════ -->

    <!-- 基础卡片：白底大圆角 + 柔和阴影 -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}"/>
        <Setter Property="Padding" Value="{StaticResource CardPadding}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderLineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{StaticResource ShadowColor}"
                                  BlurRadius="28"
                                  ShadowDepth="4"
                                  Direction="270"
                                  Opacity="0.10"/>
            </Setter.Value>
        </Setter>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- 可悬浮卡片 -->
    <Style x:Key="CardHoverable" TargetType="Border" BasedOn="{StaticResource Card}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource CardHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 强调卡片：珊瑚橘浅底（用于状态提示等） -->
    <Style x:Key="CardAccent" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Effect" Value="{x:Null}"/>
    </Style>

    <!-- ══════════ 文本样式 ══════════ -->

    <!-- 页面标题：28 Bold -->
    <Style x:Key="TextPageTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <!-- 卡片标题：17 SemiBold -->
    <Style x:Key="TextCardTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <!-- 标签文字：13 暖灰 -->
    <Style x:Key="TextLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>

    <!-- 小字：12 暖灰 -->
    <Style x:Key="TextSmall" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>

    <!-- ══════════ 数字样式 ══════════ -->

    <!-- 超大数字：金额薄荷绿（本月已赚） -->
    <Style x:Key="NumberHuge" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyNumber}"/>
        <Setter Property="FontSize" Value="64"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource MoneyBrush}"/>
    </Style>

    <!-- 大数字：32 Bold -->
    <Style x:Key="NumberLarge" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyNumber}"/>
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <!-- 中数字：24 SemiBold -->
    <Style x:Key="NumberMedium" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyNumber}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <!-- 小数字：20 SemiBold -->
    <Style x:Key="NumberSmall" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyNumber}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

</ResourceDictionary>
