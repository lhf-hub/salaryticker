<!-- ============================================================================
     BTheme.xaml —— B 流水台账方向的实验主题（experiment/ui-refresh）
     只提供新 key，旧 Colors/Styles/Controls 保持不动，便于逐 surface 迁移。
     ============================================================================ -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── 颜色 ───────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="BPaperBrush" Color="#F6F5F1"/>
    <SolidColorBrush x:Key="BInkBrush" Color="#1F2724"/>
    <SolidColorBrush x:Key="BMutedBrush" Color="#616B64"/>
    <SolidColorBrush x:Key="BRuleBrush" Color="#D5DAD3"/>
    <SolidColorBrush x:Key="BControlBrush" Color="#7F8A82"/>
    <SolidColorBrush x:Key="BGreenBrush" Color="#17694F"/>
    <SolidColorBrush x:Key="BRedBrush" Color="#A4483A"/>
    <SolidColorBrush x:Key="BWarnBrush" Color="#A45A0B"/>
    <SolidColorBrush x:Key="BWhiteBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BHoverBrush" Color="#ECE9E2"/>
    <SolidColorBrush x:Key="BPressedBrush" Color="#E2DED5"/>

    <!-- ── FocusVisual：必须是 Style 包 ControlTemplate ───────── -->
    <Style x:Key="BFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{StaticResource BGreenBrush}"
                            BorderThickness="2"
                            CornerRadius="4"
                            Margin="2"
                            SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 文本 ───────────────────────────────────────────────── -->
    <Style x:Key="BLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource BMutedBrush}"/>
    </Style>

    <Style x:Key="BSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource BMutedBrush}"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>

    <Style x:Key="BRowLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource BMutedBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="BRowValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BInkBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyNumber}"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>

    <Style x:Key="BHeroAmountStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="56"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BInkBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyNumber}"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>

    <!-- ── 状态点 ─────────────────────────────────────────────── -->
    <Style x:Key="BStatusDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="6"/>
        <Setter Property="Height" Value="6"/>
        <Setter Property="Fill" Value="{StaticResource BMutedBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="Earning">
                <Setter Property="Fill" Value="{StaticResource BGreenBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="LunchBreak">
                <Setter Property="Fill" Value="{StaticResource BWarnBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="ForcedRest">
                <Setter Property="Fill" Value="{StaticResource BWarnBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ── 按钮 ───────────────────────────────────────────────── -->
    <Style x:Key="BButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource BInkBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="BorderBrush" Value="{StaticResource BControlBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource BFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource BHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{StaticResource BPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BButtonStyle}">
        <Setter Property="Background" Value="{StaticResource BInkBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BInkBrush}"/>
    </Style>

    <Style x:Key="BTopButtonStyle" TargetType="Button" BasedOn="{StaticResource BButtonStyle}">
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style x:Key="BMuyuButtonStyle" TargetType="Button" BasedOn="{StaticResource BButtonStyle}">
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
    </Style>

</ResourceDictionary>
