<!-- ============================================================================
     文件名：ConfirmDialog.xaml
     功能描述：轻量自定义确认对话框（Warm 暖白卡片 + 胶囊按钮）
     ============================================================================ -->
<Window x:Class="SalaryTicker.Dialogs.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/SalaryTicker.ico"
        Title="确认"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="ButtonGhost" TargetType="Button"
               BasedOn="{StaticResource WGhostButtonStyle}"/>
        <Style x:Key="ButtonPrimary" TargetType="Button"
               BasedOn="{StaticResource WPrimaryButtonStyle}"/>
        <Style x:Key="ButtonDanger" TargetType="Button"
               BasedOn="{StaticResource WCoralButtonStyle}"/>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.15"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border Background="{StaticResource WSurfaceBrush}"
            CornerRadius="16"
            BorderBrush="{StaticResource WBorderBrush}"
            BorderThickness="1"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="#5A3C28"
                              BlurRadius="26" ShadowDepth="6" Opacity="0.18"/>
        </Border.Effect>

        <Grid Margin="26,24,26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       x:Name="TitleText"
                       Text="确认操作"
                       Style="{StaticResource WPanelTitleStyle}"
                       Margin="0,0,0,10"/>

            <TextBlock Grid.Row="1"
                       x:Name="MessageText"
                       Text=""
                       Style="{StaticResource WBodyStyle}"
                       Margin="0,0,0,20"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消"
                        Style="{StaticResource ButtonGhost}"
                        Click="Cancel_Click"
                        IsCancel="True"
                        Margin="0,0,10,0"/>
                <Button Content="确定"
                        x:Name="OkButton"
                        Style="{StaticResource ButtonPrimary}"
                        Click="Ok_Click"
                        IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
