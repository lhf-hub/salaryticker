<!-- DesignSpikeWindow.xaml —— B 流水台账方向的 WPF 保真 spike（临时验收窗口） -->
<Window x:Class="SalaryTicker.Views.DesignSpikeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="B 流水台账 · WPF 保真 spike"
        Width="1100" Height="640"
        WindowStartupLocation="CenterScreen"
        Background="#F6F5F1"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <SolidColorBrush x:Key="BInk" Color="#1F2724"/>
        <SolidColorBrush x:Key="BMuted" Color="#616B64"/>
        <SolidColorBrush x:Key="BRule" Color="#D5DAD3"/>
        <SolidColorBrush x:Key="BControl" Color="#7F8A82"/>
        <SolidColorBrush x:Key="BGreen" Color="#17694F"/>
        <SolidColorBrush x:Key="BRed" Color="#A4483A"/>
        <SolidColorBrush x:Key="BPaper" Color="#F6F5F1"/>
        <SolidColorBrush x:Key="BWhite" Color="#FFFFFF"/>

        <!-- FocusVisualStyle 必须是 Style 包 ControlTemplate，不能直接给 Template -->
        <Style x:Key="BFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="{StaticResource BGreen}"
                                BorderThickness="2"
                                CornerRadius="4"
                                Margin="2"
                                SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BButton" TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource BInk}"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BControl}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource BFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#ECE9E2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#E2DED5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BPrimaryButton" TargetType="Button" BasedOn="{StaticResource BButton}">
            <Setter Property="Background" Value="{StaticResource BInk}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BInk}"/>
        </Style>

        <Style x:Key="BDangerButton" TargetType="Button" BasedOn="{StaticResource BButton}">
            <Setter Property="BorderBrush" Value="{StaticResource BRed}"/>
        </Style>

        <Style x:Key="BTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource BInk}"/>
            <Setter Property="Background" Value="{StaticResource BWhite}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BControl}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="B 流水台账 · WPF 保真 spike"
                       FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource BInk}"/>
            <TextBlock Text="只验证机械事实：Segoe UI 等宽数字、1 DIP 规则线、focus ring、DPI。不是最终界面。"
                       Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource BMuted}"/>
            <TextBlock x:Name="DiagText" FontSize="10" Foreground="{StaticResource BRed}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 流水样张 -->
        <Border x:Name="StatementPanel" Grid.Row="3"
                Background="#FBFBF8"
                BorderBrush="{StaticResource BRule}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="20,14"
                Margin="0,0,0,16">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="2026 年 10 月" FontSize="12" Foreground="{StaticResource BMuted}"/>
                    <TextBlock DockPanel.Dock="Right" Text="18 个计薪日" FontSize="12" Foreground="{StaticResource BMuted}"/>
                </DockPanel>

                <DockPanel LastChildFill="False" Margin="0,12,0,0">
                    <TextBlock DockPanel.Dock="Left" Text="本月已赚" FontSize="14" Foreground="{StaticResource BMuted}" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                    <TextBlock x:Name="HeroAmount"
                               DockPanel.Dock="Right"
                               Text="¥7,882.02"
                               FontFamily="Segoe UI"
                               FontSize="56"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BInk}"
                               Typography.NumeralAlignment="Tabular"/>
                </DockPanel>

                <StackPanel Margin="0,16,0,0">
                    <Border Height="1" Background="{StaticResource BInk}"/>
                    <Border Height="1" Background="{StaticResource BInk}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- 台账行 -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="22"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="本月进度" FontSize="13" Foreground="{StaticResource BMuted}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="10" Height="4" Margin="0,0,3,0" Background="{StaticResource BGreen}"/>
                        <Border Width="10" Height="4" Margin="0,0,3,0" Background="{StaticResource BGreen}"/>
                        <Border Width="10" Height="4" Margin="0,0,3,0" Background="{StaticResource BGreen}"/>
                        <Border Width="10" Height="4" Margin="0,0,3,0" Background="{StaticResource BGreen}"/>
                        <Border Width="10" Height="4" Margin="0,0,3,0" Background="{StaticResource BGreen}"/>
                        <Border Width="10" Height="4" Margin="0,0,3,0" Background="{StaticResource BGreen}"/>
                        <Border Width="10" Height="4" Margin="0,0,3,0" Background="{StaticResource BGreen}"/>
                        <Border Width="10" Height="4" Margin="0,0,3,0" Background="{StaticResource BGreen}"/>
                        <Border Width="10" Height="4" Margin="0,0,3,0" Background="{StaticResource BGreen}"/>
                        <Border Width="10" Height="4" Margin="0,0,3,0" Background="{StaticResource BRule}"/>
                        <Border Width="10" Height="4" Margin="0,0,3,0" Background="{StaticResource BRule}"/>
                        <Border Width="10" Height="4" Margin="0,0,3,0" Background="{StaticResource BRule}"/>
                        <Border Width="10" Height="4" Margin="0,0,3,0" Background="{StaticResource BRule}"/>
                        <Border Width="10" Height="4" Margin="0,0,3,0" Background="{StaticResource BRule}"/>
                        <Border Width="10" Height="4" Margin="0,0,3,0" Background="{StaticResource BRule}"/>
                        <Border Width="10" Height="4" Margin="0,0,3,0" Background="{StaticResource BRule}"/>
                        <Border Width="10" Height="4" Margin="0,0,3,0" Background="{StaticResource BRule}"/>
                        <Border Width="10" Height="4" Background="{StaticResource BRule}"/>
                        <TextBlock Text="50.0%" Margin="10,0,0,0" FontSize="13" Foreground="{StaticResource BInk}" Typography.NumeralAlignment="Tabular"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="还剩工作日" FontSize="13" Foreground="{StaticResource BMuted}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="9 天" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BInk}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Text="税后月薪" FontSize="13" Foreground="{StaticResource BMuted}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="¥16,601.20" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BInk}" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                    <TextBlock Grid.Row="3" Text="日薪" FontSize="13" Foreground="{StaticResource BMuted}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="¥875.78" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BInk}" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                    <TextBlock Grid.Row="4" Text="秒薪" FontSize="13" Foreground="{StaticResource BMuted}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="¥0.0304" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BInk}" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                </Grid>

                <Border Height="1" Background="{StaticResource BRule}" Margin="0,10,0,0"/>
                <DockPanel LastChildFill="False" Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Left" Text="距下班" FontSize="13" Foreground="{StaticResource BMuted}"/>
                    <TextBlock DockPanel.Dock="Right" Text="02:14:36" FontFamily="Segoe UI" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource BInk}" Typography.NumeralAlignment="Tabular"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- 组件状态 -->
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="组件状态（临时样式，Phase 2 才进正式设计系统）" FontSize="12" Foreground="{StaticResource BMuted}" Margin="0,0,0,10"/>
            <WrapPanel>
                <Button x:Name="FocusTarget" Style="{StaticResource BPrimaryButton}" FocusVisualStyle="{StaticResource BFocusVisual}">
                    <TextBlock Text="保存" FontSize="13" Foreground="{StaticResource BPaper}"/>
                </Button>
                <Button Style="{StaticResource BButton}">
                    <TextBlock Text="取消" FontSize="13" Foreground="{StaticResource BInk}"/>
                </Button>
                <Button Style="{StaticResource BButton}" BorderBrush="Transparent">
                    <TextBlock Text="跳过" FontSize="13" Foreground="{StaticResource BMuted}"/>
                </Button>
                <Button Style="{StaticResource BDangerButton}">
                    <TextBlock Text="清空" FontSize="13" Foreground="{StaticResource BRed}"/>
                </Button>
                <Button Style="{StaticResource BPrimaryButton}" IsEnabled="False">
                    <TextBlock Text="保存" FontSize="13" Foreground="{StaticResource BPaper}"/>
                </Button>
                <TextBox Style="{StaticResource BTextBox}" Width="160" Text="20000" Margin="8,0,0,0"/>
                <Border BorderBrush="{StaticResource BGreen}" BorderThickness="2" CornerRadius="6" Padding="2" Margin="12,0,0,0">
                    <Button Style="{StaticResource BPrimaryButton}">
                        <TextBlock Text="focus ring" FontSize="13" Foreground="{StaticResource BPaper}"/>
                    </Button>
                </Border>
            </WrapPanel>
        </StackPanel>

        <!-- 指标 -->
        <Border Grid.Row="1"
                Background="{StaticResource BWhite}"
                BorderBrush="{StaticResource BRule}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="14,10"
                VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="机械检查" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BInk}"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock x:Name="TabOne" Text="1111111111" FontFamily="Segoe UI" FontSize="24" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="TabZero" Text="0000000000" FontFamily="Segoe UI" FontSize="24" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Left" Margin="24,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="TabStatus" Text="等宽数字：检查中…" FontSize="13" Foreground="{StaticResource BMuted}" Margin="0,6,0,0"/>
                <TextBlock x:Name="DpiText" Text="DPI：检查中…" FontSize="12" Foreground="{StaticResource BMuted}" Margin="0,4,0,0"/>
                <Border Height="1" Background="{StaticResource BRule}" Margin="0,12,0,8"/>
                <TextBlock Text="上面这条是 1 DIP 规则线；125/150/200% 需 4K/VM 环境验证。" FontSize="12" Foreground="{StaticResource BMuted}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
