<!-- StyleGalleryWindow.xaml —— 设计系统样式画廊（阶段验收窗口） -->
<Window x:Class="SalaryTicker.Views.StyleGalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/SalaryTicker.ico"
        Title="设计系统样式画廊 - SalaryTicker 实时计算器"
        Width="1100" Height="760"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgPageBrush}">
    <Grid Margin="{StaticResource PageMargin}">
        <Grid.ColumnDefinitions>
            <!-- 左侧主滚动区域 -->
            <ColumnDefinition Width="*"/>
            <!-- 右侧边栏：颜色 / 字体速览 -->
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════ 左列：分区展示 ══════════ -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24" >

                <!-- ① 颜色 Token 色板 -->
                <TextBlock Text="① 颜色 Token 色板" Style="{StaticResource TextPageTitle}" Margin="0,0,0,16"/>
                <WrapPanel Margin="0,0,0,16">
                    <StackPanel Width="130" Margin="8" HorizontalAlignment="Left">
                        <Border Height="56" CornerRadius="8" Background="{DynamicResource PrimaryBrush}"/>
                        <TextBlock Text="PrimaryBrush (#E07A5F)" Style="{StaticResource TextSmall}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Width="130" Margin="8" HorizontalAlignment="Left">
                        <Border Height="56" CornerRadius="8" Background="{DynamicResource PrimaryBrightBrush}"/>
                        <TextBlock Text="PrimaryBrightBrush (#EE8A6D)" Style="{StaticResource TextSmall}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Width="130" Margin="8" HorizontalAlignment="Left">
                        <Border Height="56" CornerRadius="8" Background="{DynamicResource InfoBrush}"/>
                        <TextBlock Text="InfoBrush (#5B8DB8)" Style="{StaticResource TextSmall}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Width="130" Margin="8" HorizontalAlignment="Left">
                        <Border Height="56" CornerRadius="8" Background="{DynamicResource WarnBrush}"/>
                        <TextBlock Text="WarnBrush (#F4A261)" Style="{StaticResource TextSmall}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Width="130" Margin="8" HorizontalAlignment="Left">
                        <Border Height="56" CornerRadius="8" Background="{DynamicResource DangerBrush}"/>
                        <TextBlock Text="DangerBrush (#E76F51)" Style="{StaticResource TextSmall}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Width="130" Margin="8" HorizontalAlignment="Left">
                        <Border Height="56" CornerRadius="8" Background="{DynamicResource BgPageBrush}" BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1"/>
                        <TextBlock Text="BgPageBrush (#FAF7F2)" Style="{StaticResource TextSmall}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Width="130" Margin="8" HorizontalAlignment="Left">
                        <Border Height="56" CornerRadius="8" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1"/>
                        <TextBlock Text="CardBrush (#FFFFFF)" Style="{StaticResource TextSmall}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Width="130" Margin="8" HorizontalAlignment="Left">
                        <Border Height="56" CornerRadius="8" Background="{DynamicResource CardHoverBrush}"/>
                        <TextBlock Text="CardHoverBrush (#FFFBF7)" Style="{StaticResource TextSmall}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Width="130" Margin="8" HorizontalAlignment="Left">
                        <Border Height="56" CornerRadius="8" Background="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="TextPrimaryBrush (#2D2A26)" Style="{StaticResource TextSmall}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Width="130" Margin="8" HorizontalAlignment="Left">
                        <Border Height="56" CornerRadius="8" Background="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="TextSecondaryBrush (#7D7469)" Style="{StaticResource TextSmall}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Width="130" Margin="8" HorizontalAlignment="Left">
                        <Border Height="56" CornerRadius="8" Background="{DynamicResource InputBgBrush}"/>
                        <TextBlock Text="InputBgBrush (#FFFFFF)" Style="{StaticResource TextSmall}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Width="130" Margin="8" HorizontalAlignment="Left">
                        <Border Height="56" CornerRadius="8" Background="{DynamicResource ProgressGradientBrush}"/>
                        <TextBlock Text="ProgressGradientBrush (蜜桃橙 → 薄荷绿)" Style="{StaticResource TextSmall}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </WrapPanel>

                <!-- ② 字体与数字 -->
                <TextBlock Text="② 字体与数字" Style="{StaticResource TextPageTitle}" Margin="0,24,0,16"/>
                <Border Style="{StaticResource Card}" Padding="24">
                    <StackPanel>
                        <!-- 超大数字 -->
                        <TextBlock Text="¥12,345.67" Style="{StaticResource NumberHuge}" Margin="0,0,0,8"/>
                        <!-- 大数字 -->
                        <TextBlock Text="¥8,900.00" Style="{StaticResource NumberLarge}" Margin="0,0,0,8"/>
                        <!-- 小数字 -->
                        <TextBlock Text="¥26.50" Style="{StaticResource NumberSmall}" Margin="0,0,0,8"/>
                        <Separator Margin="0,8" Opacity="0.3"/>
                        <!-- 页面标题 -->
                        <TextBlock Text="This is a Page Title (28 Bold)" Style="{StaticResource TextPageTitle}" Margin="0,8,0,0"/>
                        <!-- 卡片标题 -->
                        <TextBlock Text="Card Title (20 SemiBold)" Style="{StaticResource TextCardTitle}" Margin="0,8,0,0"/>
                        <!-- 标签文字 -->
                        <TextBlock Text="Label text description (14 Secondary)" Style="{StaticResource TextLabel}" Margin="0,8,0,0"/>
                        <!-- 小字 -->
                        <TextBlock Text="Extra small notes or hints (12 Secondary)" Style="{StaticResource TextSmall}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ③ 按钮样式 -->
                <TextBlock Text="③ 按钮" Style="{StaticResource TextPageTitle}" Margin="0,24,0,16"/>
                <WrapPanel Margin="0,0,0,16">
                    <!-- 默认按钮 -->
                    <Button Content="默认 Button" Margin="8" Padding="16,8"/>
                    <!-- 主按钮 -->
                    <Button Content="主要 ButtonPrimary" Style="{StaticResource ButtonPrimary}" Margin="8" Padding="16,8"/>
                    <!-- Ghost 按钮 -->
                    <Button Content="Ghost ButtonGhost" Style="{StaticResource ButtonGhost}" Margin="8" Padding="16,8"/>
                    <!-- 危险按钮 -->
                    <Button Content="危险 ButtonDanger" Style="{StaticResource ButtonDanger}" Margin="8" Padding="16,8"/>
                    <!-- 图标按钮 -->
                    <Button Content="🔔" Style="{StaticResource ButtonIcon}" Margin="8" Padding="8"/>
                    <!-- Disabled 态 -->
                    <Button Content="禁用 Disabled" IsEnabled="False" Margin="8" Padding="16,8"/>
                    <Button Content="禁用 Primary" Style="{StaticResource ButtonPrimary}" IsEnabled="False" Margin="8" Padding="16,8"/>
                    <Button Content="禁用 Ghost" Style="{StaticResource ButtonGhost}" IsEnabled="False" Margin="8" Padding="16,8"/>
                    <Button Content="禁用 Danger" Style="{StaticResource ButtonDanger}" IsEnabled="False" Margin="8" Padding="16,8"/>
                </WrapPanel>

                <!-- ④ 输入控件 -->
                <TextBlock Text="④ 输入控件" Style="{StaticResource TextPageTitle}" Margin="0,24,0,16"/>
                <Border Style="{StaticResource Card}" Padding="24">
                    <StackPanel>
                        <!-- TextBox 普通 -->
                        <TextBlock Text="普通 TextBox：" Style="{StaticResource TextLabel}" Margin="0,0,0,4"/>
                        <TextBox Margin="0,0,0,8" Width="300"
                                 Text="请输入 salary..." />
                        <!-- TextBox 聚焦提示 -->
                        <TextBlock Text="聚焦提示框（带 placeholder）：" Style="{StaticResource TextLabel}" Margin="0,0,0,4"/>
                        <TextBox Margin="0,0,0,8" Width="300"
                                 Foreground="{DynamicResource TextDisabledBrush}"
                                 Text="此处显示占位提示文字...">
                        </TextBox>
                        <Separator Margin="0,8" Opacity="0.3"/>
                        <!-- ComboBox -->
                        <TextBlock Text="医保档位选择：" Style="{StaticResource TextLabel}" Margin="0,0,0,4"/>
                        <ComboBox Margin="0,0,0,8" Width="240">
                            <ComboBoxItem Content="一档进医保"/>
                            <ComboBoxItem Content="二档进医保"/>
                            <ComboBoxItem Content="不进医保"/>
                        </ComboBox>
                        <TextBlock Text="工作时间制选择：" Style="{StaticResource TextLabel}" Margin="0,8,0,4"/>
                        <ComboBox Margin="0,0,0,8" Width="240">
                            <ComboBoxItem Content="五天八小时双休"/>
                            <ComboBoxItem Content="五天八小时大小周"/>
                            <ComboBoxItem Content="做六休一"/>
                        </ComboBox>
                        <Separator Margin="0,8" Opacity="0.3"/>
                        <!-- CheckBox -->
                        <CheckBox Content="勾选状态 Checked" IsChecked="True" Margin="0,8,0,4"
                                 />
                        <CheckBox Content="未勾选状态 Unchecked" IsChecked="False" Margin="0,0,0,4"
                                 />
                        <!-- RadioButton -->
                        <RadioButton Content="单选 A" IsChecked="True" Margin="0,8,0,4"
                                    />
                        <RadioButton Content="单选 B" Margin="0,0,0,4"
                                    />
                        <Separator Margin="0,8" Opacity="0.3"/>
                        <!-- Slider -->
                        <Slider Minimum="0" Maximum="100" Value="60" Margin="0,8,0,0"
                                Width="300"/>
                    </StackPanel>
                </Border>

                <!-- ⑤ 进度条 + ListBox -->
                <TextBlock Text="⑤ 进度条 &amp; ListBox" Style="{StaticResource TextPageTitle}" Margin="0,24,0,16"/>
                <Border Style="{StaticResource Card}" Padding="24">
                    <StackPanel>
                        <ProgressBar Value="65" Height="20" Margin="0,0,0,8"
                                     Background="{DynamicResource CardHoverBrush}"
                                     Foreground="{DynamicResource ProgressGradientBrush}"/>
                        <ListBox Margin="0,8,0,0" Width="280" Height="100"
                                >
                            <ListBoxItem Content="已完成：参数配置"/>
                            <ListBoxItem Content="进行中：计算引擎优化"/>
                            <ListBoxItem Content="待处理：UI 走查"/>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- ⑥ 卡片容器 -->
                <TextBlock Text="⑥ 卡片容器" Style="{StaticResource TextPageTitle}" Margin="0,24,0,16"/>
                <WrapPanel Margin="0,0,0,16">
                    <Border Style="{StaticResource Card}" Width="400" Margin="8">
                        <StackPanel>
                            <TextBlock Text="示例卡片 A" Style="{StaticResource TextCardTitle}" Margin="0,0,0,8"/>
                            <TextBlock Text="这是一个标准卡片容器示例，带有圆角边框和阴影效果。" Style="{StaticResource TextLabel}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Width="400" Margin="8">
                        <StackPanel>
                            <TextBlock Text="示例卡片 B（悬浮）" Style="{StaticResource TextCardTitle}" Margin="0,0,0,8"/>
                            <TextBlock Text="将鼠标悬停在此卡片上查看悬浮背景切换效果。" Style="{StaticResource TextLabel}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
                <!-- 可悬浮卡片单独演示 -->
                <Border Style="{StaticResource CardHoverable}" Width="400" Margin="8" Padding="20">
                    <TextBlock Text="💡 CardHoverable 悬浮卡片 — 将鼠标放上来试试！" Style="{StaticResource TextCardTitle}"/>
                </Border>

                <!-- ⑦ 图标全览 -->
                <TextBlock Text="⑦ 图标全览" Style="{StaticResource TextPageTitle}" Margin="0,24,0,16"/>
                <Border Style="{StaticResource Card}" Padding="24">
                    <WrapPanel ItemWidth="76" ItemHeight="76">
                        <!-- ⚙️ -->
                        <StackPanel HorizontalAlignment="Left" Margin="4">
                            <Border Background="{DynamicResource PrimarySoftBrush}" CornerRadius="8" Width="56" Height="56"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconSettings}" Fill="{DynamicResource PrimaryBrush}" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="IconSettings" Style="{StaticResource TextSmall}" TextAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <!-- 🖥 -->
                        <StackPanel HorizontalAlignment="Left" Margin="4">
                            <Border Background="{DynamicResource InfoSoftBrush}" CornerRadius="8" Width="56" Height="56"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconMiniWindow}" Fill="{DynamicResource InfoBrush}" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="IconMiniWindow" Style="{StaticResource TextSmall}" TextAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <!-- 🐟 -->
                        <StackPanel HorizontalAlignment="Left" Margin="4">
                            <Border Background="#33F59E0B" CornerRadius="8" Width="56" Height="56"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconFish}" Fill="{DynamicResource WarnBrush}" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="IconFish" Style="{StaticResource TextSmall}" TextAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <!-- ← -->
                        <StackPanel HorizontalAlignment="Left" Margin="4">
                            <Border Background="{DynamicResource PrimarySoftBrush}" CornerRadius="8" Width="56" Height="56"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconBack}" Fill="{DynamicResource TextPrimaryBrush}" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="IconBack" Style="{StaticResource TextSmall}" TextAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <!-- ✕ -->
                        <StackPanel HorizontalAlignment="Left" Margin="4">
                            <Border Background="{DynamicResource DangerSoftBrush}" CornerRadius="8" Width="56" Height="56"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconClose}" Fill="{DynamicResource DangerBrush}" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="IconClose" Style="{StaticResource TextSmall}" TextAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <!-- 🕐 -->
                        <StackPanel HorizontalAlignment="Left" Margin="4">
                            <Border Background="{DynamicResource PrimarySoftBrush}" CornerRadius="8" Width="56" Height="56"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconHistory}" Fill="{DynamicResource TextSecondaryBrush}" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="IconHistory" Style="{StaticResource TextSmall}" TextAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <!-- 🗑 -->
                        <StackPanel HorizontalAlignment="Left" Margin="4">
                            <Border Background="{DynamicResource DangerSoftBrush}" CornerRadius="8" Width="56" Height="56"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconTrash}" Fill="{DynamicResource DangerBrush}" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="IconTrash" Style="{StaticResource TextSmall}" TextAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <!-- ⓘ -->
                        <StackPanel HorizontalAlignment="Left" Margin="4">
                            <Border Background="{DynamicResource InfoSoftBrush}" CornerRadius="8" Width="56" Height="56"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconInfo}" Fill="{DynamicResource InfoBrush}" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="IconInfo" Style="{StaticResource TextSmall}" TextAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <!-- ⚠ -->
                        <StackPanel HorizontalAlignment="Left" Margin="4">
                            <Border Background="#33F59E0B" CornerRadius="8" Width="56" Height="56"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconWarning}" Fill="{DynamicResource WarnBrush}" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="IconWarning" Style="{StaticResource TextSmall}" TextAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <!-- ✓ -->
                        <StackPanel HorizontalAlignment="Left" Margin="4">
                            <Border Background="{DynamicResource PrimarySoftBrush}" CornerRadius="8" Width="56" Height="56"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconCheck}" Fill="{DynamicResource PrimaryBrush}" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="IconCheck" Style="{StaticResource TextSmall}" TextAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <!-- ❤ -->
                        <StackPanel HorizontalAlignment="Left" Margin="4">
                            <Border Background="{DynamicResource DangerSoftBrush}" CornerRadius="8" Width="56" Height="56"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconHeart}" Fill="{DynamicResource DangerBrush}" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="IconHeart" Style="{StaticResource TextSmall}" TextAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <!-- ➕ -->
                        <StackPanel HorizontalAlignment="Left" Margin="4">
                            <Border Background="{DynamicResource PrimarySoftBrush}" CornerRadius="8" Width="56" Height="56"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconPlus}" Fill="{DynamicResource TextPrimaryBrush}" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="IconPlus" Style="{StaticResource TextSmall}" TextAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <!-- 🔄 -->
                        <StackPanel HorizontalAlignment="Left" Margin="4">
                            <Border Background="{DynamicResource PrimarySoftBrush}" CornerRadius="8" Width="56" Height="56"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconRefresh}" Fill="{DynamicResource TextPrimaryBrush}" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="IconRefresh" Style="{StaticResource TextSmall}" TextAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <!-- ✏️ -->
                        <StackPanel HorizontalAlignment="Left" Margin="4">
                            <Border Background="{DynamicResource InfoSoftBrush}" CornerRadius="8" Width="56" Height="56"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconEdit}" Fill="{DynamicResource InfoBrush}" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="IconEdit" Style="{StaticResource TextSmall}" TextAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </WrapPanel>
                </Border>

                <!-- 底部间距 -->
                <Rectangle Height="40"/>

            </StackPanel>
        </ScrollViewer>

        <!-- ══════════ 右栏：速览面板 ══════════ -->
        <Border Grid.Column="1" Background="{DynamicResource CardBrush}" CornerRadius="16" Margin="16,0"
                BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                <StackPanel>
                    <TextBlock Text="快速参考" Style="{StaticResource TextCardTitle}" Margin="0,0,0,12"/>

                    <!-- 色板缩略 -->
                    <TextBlock Text="色板" Style="{StaticResource TextLabel}" Margin="0,0,0,8"/>
                    <WrapPanel Margin="0,0,0,16">
                        <Border Width="24" Height="24" CornerRadius="4" Background="{DynamicResource PrimaryBrush}" ToolTip="Primary" Margin="2"/>
                        <Border Width="24" Height="24" CornerRadius="4" Background="{DynamicResource InfoBrush}" ToolTip="Info" Margin="2"/>
                        <Border Width="24" Height="24" CornerRadius="4" Background="{DynamicResource WarnBrush}" ToolTip="Warn" Margin="2"/>
                        <Border Width="24" Height="24" CornerRadius="4" Background="{DynamicResource DangerBrush}" ToolTip="Danger" Margin="2"/>
                        <Border Width="24" Height="24" CornerRadius="4" Background="{DynamicResource TextPrimaryBrush}" ToolTip="TextPrimary" Margin="2"/>
                        <Border Width="24" Height="24" CornerRadius="4" Background="{DynamicResource TextSecondaryBrush}" ToolTip="TextSecondary" Margin="2"/>
                    </WrapPanel>

                    <!-- 尺寸参考 -->
                    <TextBlock Text="字号 / 间距" Style="{StaticResource TextLabel}" Margin="0,0,0,8"/>
                    <StackPanel>
                        <TextBlock Text="Huge = 64" Style="{StaticResource TextSmall}" Margin="0,2"/>
                        <TextBlock Text="Large = 32" Style="{StaticResource TextSmall}" Margin="0,2"/>
                        <TextBlock Text="Medium = 20" Style="{StaticResource TextSmall}" Margin="0,2"/>
                        <TextBlock Text="Normal = 14" Style="{StaticResource TextSmall}" Margin="0,2"/>
                        <TextBlock Text="Small = 12" Style="{StaticResource TextSmall}" Margin="0,2"/>
                    </StackPanel>
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="PageMargin = 24" Style="{StaticResource TextSmall}" Margin="0,2"/>
                        <TextBlock Text="CardPadding = 24" Style="{StaticResource TextSmall}" Margin="0,2"/>
                        <TextBlock Text="InnerSpace = 8" Style="{StaticResource TextSmall}" Margin="0,2"/>
                    </StackPanel>

                    <!-- 圆角参考 -->
                    <TextBlock Text="圆角" Style="{StaticResource TextLabel}" Margin="0,16,0,8"/>
                    <StackPanel>
                        <Border Background="{DynamicResource CardHoverBrush}" BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1" CornerRadius="24" Width="60" Height="40" Margin="0,2"/>
                        <TextBlock Text="RadiusCard = 24" Style="{StaticResource TextSmall}" Margin="0,2"/>
                        <Border Background="{DynamicResource CardHoverBrush}" BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1" CornerRadius="999" Width="60" Height="40" Margin="0,2"/>
                        <TextBlock Text="RadiusButton = 999" Style="{StaticResource TextSmall}" Margin="0,2"/>
                        <Border Background="{DynamicResource CardHoverBrush}" BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1" CornerRadius="14" Width="60" Height="40" Margin="0,2"/>
                        <TextBlock Text="RadiusInput = 14" Style="{StaticResource TextSmall}" Margin="0,2"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>

    </Grid>
</Window>
