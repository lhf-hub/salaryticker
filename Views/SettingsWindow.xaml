<!-- ============================================================================
     文件名：SettingsWindow.xaml
     功能描述：设置窗口（左侧导航 + 右侧六个分区）
     ============================================================================ -->
<Window x:Class="SalaryTicker.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/SalaryTicker.ico"
        xmlns:vm="clr-namespace:SalaryTicker.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        mc:Ignorable="d"
        Title="设置 - SalaryTicker"
        Width="960" Height="720"
        MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgPageBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════ 左侧导航 ══════════ -->
        <Border Grid.Row="0" Grid.Column="0"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderLineBrush}"
                BorderThickness="0,0,1,0">
            <StackPanel Margin="12,20">
                <TextBlock Text="设置" Style="{StaticResource TextCardTitle}" Margin="12,0,0,20"/>

                <ListBox SelectedIndex="{Binding SelectedPageIndex}" Background="Transparent" BorderThickness="0">
                    <ListBoxItem Content="💰 工资与五险一金" Padding="12,10"/>
                    <ListBoxItem Content="📊 个税参数" Padding="12,10"/>
                    <ListBoxItem Content="⏰ 班制设置" Padding="12,10"/>
                    <ListBoxItem Content="🐟 摸鱼按钮" Padding="12,10"/>
                    <ListBoxItem Content="🔧 政策参数" Padding="12,10"/>
                    <ListBoxItem Content="🔄 更新" Padding="12,10"/>
                    <ListBoxItem Content="ℹ️ 关于" Padding="12,10"/>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- ══════════ 右侧内容区 ══════════ -->
        <ScrollViewer Grid.Row="0" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24">
          <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 错误提示 -->
            <Border Grid.Row="0"
                    Background="{StaticResource DangerSoftBrush}"
                    CornerRadius="8" Padding="12,8" Margin="0,0,0,16"
                    Visibility="{Binding IsErrorVisible, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
            </Border>

            <!-- ══════ 分区 1：工资与五险一金 ══════ -->
            <StackPanel Grid.Row="1" Visibility="{Binding SelectedPageIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=0}">
                <TextBlock Text="工资与五险一金" Style="{StaticResource TextPageTitle}" Margin="0,0,0,16"/>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="工资模式" Style="{StaticResource TextCardTitle}" Margin="0,0,0,12"/>
                        <RadioButton Content="税前模式（计算五险一金与个税）" IsChecked="{Binding IsGrossMode}"
                                     GroupName="SalaryMode" Margin="0,0,0,8"/>
                        <RadioButton Content="税后模式（直接输入到手金额）" IsChecked="{Binding IsNetMode}"
                                     GroupName="SalaryMode"/>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="税前月薪（元）" Style="{StaticResource TextLabel}"
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding GrossSalary, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsGrossMode}" Width="200" HorizontalAlignment="Left"/>
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="税后月薪（元）" Style="{StaticResource TextLabel}"
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding NetSalary, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsGrossMode, Converter={StaticResource InverseBool}}"
                                     Width="200" HorizontalAlignment="Left"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 养老保险 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                        IsEnabled="{Binding IsGrossMode}">
                    <StackPanel>
                        <TextBlock Text="养老保险" Style="{StaticResource TextCardTitle}" Margin="0,0,0,4"/>
                        <TextBlock Text="「自动」用税前工资作基数；「按下限/上限」适合公司按最低/最高基数申报"
                                   Style="{StaticResource TextSmall}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <ComboBox SelectedIndex="{Binding PensionInputModeIndex}" Width="260" Margin="0,0,0,12">
                            <ComboBoxItem Content="自动（用工资作基数）"/>
                            <ComboBoxItem Content="按下限（最低基数）"/>
                            <ComboBoxItem Content="按上限（最高基数）"/>
                            <ComboBoxItem Content="自定义基数"/>
                            <ComboBoxItem Content="直接填月缴额（按工资条）"/>
                        </ComboBox>
                        <Grid Visibility="{Binding PensionInputModeIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=3}">
                            <TextBlock Text="基数（元）" Style="{StaticResource TextLabel}" Margin="0,0,12,0"/>
                            <TextBox Text="{Binding PensionBase}" Width="160" HorizontalAlignment="Left" Margin="80,0,0,0"/>
                        </Grid>
                        <TextBox Text="{Binding PensionAmount}" Width="160" HorizontalAlignment="Left"
                                 Visibility="{Binding PensionInputModeIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=4}"/>
                        <TextBlock Text="{Binding PensionDetail}"
                                   Style="{StaticResource TextSmall}"
                                   Foreground="{StaticResource MoneyBrush}"
                                   TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 医疗保险 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                        IsEnabled="{Binding IsGrossMode}">
                    <StackPanel>
                        <TextBlock Text="医疗保险" Style="{StaticResource TextCardTitle}" Margin="0,0,0,4"/>
                        <TextBlock Text="「自动」用税前工资作基数；「按下限/上限」适合公司按最低/最高基数申报"
                                   Style="{StaticResource TextSmall}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <TextBlock Text="医保档位" Style="{StaticResource TextLabel}" Margin="0,0,0,6"/>
                        <ComboBox SelectedIndex="{Binding MedicalTierIndex}" Width="260" Margin="0,0,0,12">
                            <ComboBoxItem Content="深圳一档"/>
                            <ComboBoxItem Content="深圳二档"/>
                        </ComboBox>
                        <ComboBox SelectedIndex="{Binding MedicalInputModeIndex}" Width="260" Margin="0,0,0,12">
                            <ComboBoxItem Content="自动（用工资作基数）"/>
                            <ComboBoxItem Content="按下限（最低基数）"/>
                            <ComboBoxItem Content="按上限（最高基数）"/>
                            <ComboBoxItem Content="自定义基数"/>
                            <ComboBoxItem Content="直接填月缴额（按工资条）"/>
                        </ComboBox>
                        <TextBox Text="{Binding MedicalBase}" Width="160" HorizontalAlignment="Left"
                                 Visibility="{Binding MedicalInputModeIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=3}"/>
                        <TextBox Text="{Binding MedicalAmount}" Width="160" HorizontalAlignment="Left"
                                 Visibility="{Binding MedicalInputModeIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=4}"/>
                        <TextBlock Text="{Binding MedicalDetail}"
                                   Style="{StaticResource TextSmall}"
                                   Foreground="{StaticResource MoneyBrush}"
                                   TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 失业保险 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                        IsEnabled="{Binding IsGrossMode}">
                    <StackPanel>
                        <TextBlock Text="失业保险" Style="{StaticResource TextCardTitle}" Margin="0,0,0,4"/>
                        <TextBlock Text="「自动」用税前工资作基数；「按下限/上限」适合公司按最低/最高基数申报"
                                   Style="{StaticResource TextSmall}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <ComboBox SelectedIndex="{Binding UnemploymentInputModeIndex}" Width="260" Margin="0,0,0,12">
                            <ComboBoxItem Content="自动（用工资作基数）"/>
                            <ComboBoxItem Content="按下限（最低基数）"/>
                            <ComboBoxItem Content="按上限（最高基数）"/>
                            <ComboBoxItem Content="自定义基数"/>
                            <ComboBoxItem Content="直接填月缴额（按工资条）"/>
                        </ComboBox>
                        <TextBox Text="{Binding UnemploymentBase}" Width="160" HorizontalAlignment="Left"
                                 Visibility="{Binding UnemploymentInputModeIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=3}"/>
                        <TextBox Text="{Binding UnemploymentAmount}" Width="160" HorizontalAlignment="Left"
                                 Visibility="{Binding UnemploymentInputModeIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=4}"/>
                        <TextBlock Text="{Binding UnemploymentDetail}"
                                   Style="{StaticResource TextSmall}"
                                   Foreground="{StaticResource MoneyBrush}"
                                   TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 公积金 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                        IsEnabled="{Binding IsGrossMode}">
                    <StackPanel>
                        <TextBlock Text="住房公积金" Style="{StaticResource TextCardTitle}" Margin="0,0,0,12"/>
                        <ComboBox SelectedIndex="{Binding HousingFundModeIndex}" Width="280" Margin="0,0,0,12">
                            <ComboBoxItem Content="直接填月缴额"/>
                            <ComboBoxItem Content="基数 × 比例"/>
                            <ComboBoxItem Content="基数 × 比例 + 上限"/>
                        </ComboBox>

                        <StackPanel Margin="0,0,0,8"
                                    Visibility="{Binding HousingFundModeIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=0}">
                            <TextBlock Text="月缴额（元）" Style="{StaticResource TextLabel}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding HousingFundAmount}" Width="160" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,8"
                                    Visibility="{Binding HousingFundModeIndex, Converter={StaticResource IndexMinToVisibility}, ConverterParameter=1}">
                            <TextBlock Text="基数（元）" Style="{StaticResource TextLabel}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding HousingFundBase}" Width="160" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="比例（%）" Style="{StaticResource TextLabel}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding HousingFundRatePercent, UpdateSourceTrigger=PropertyChanged}"
                                     Width="160" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding HousingFundModeIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=2}">
                            <TextBlock Text="基数上限（元）" Style="{StaticResource TextLabel}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding HousingFundCap}" Width="160" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <TextBlock Text="{Binding HousingFundDetail}"
                                   Style="{StaticResource TextSmall}"
                                   Foreground="{StaticResource MoneyBrush}"
                                   TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 其他扣款 -->
                <Border Style="{StaticResource Card}" IsEnabled="{Binding IsGrossMode}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="其他扣款（企业年金等）" Style="{StaticResource TextCardTitle}"/>
                            <Button Content="+ 添加" Style="{StaticResource ButtonGhost}"
                                    Command="{Binding AddOtherDeductionCommand}"
                                    HorizontalAlignment="Right" Padding="12,4"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding OtherDeductions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding Name}" Margin="0,0,8,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding Amount}" Margin="0,0,8,0"/>
                                        <Button Grid.Column="2" Content="删除" Style="{StaticResource ButtonDanger}"
                                                Command="{Binding DataContext.RemoveOtherDeductionCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Padding="12,4"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ══════ 分区 2：个税参数 ══════ -->
            <StackPanel Grid.Row="1" Visibility="{Binding SelectedPageIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=1}">
                <TextBlock Text="个税参数" Style="{StaticResource TextPageTitle}" Margin="0,0,0,16"/>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="当前月份（1-12）" Style="{StaticResource TextLabel}"
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding CurrentMonth}" Width="100" HorizontalAlignment="Left"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="专项附加扣除（元/月）" Style="{StaticResource TextLabel}"
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding SpecialDeduction}" Width="160" HorizontalAlignment="Left"/>
                        </Grid>

                        <TextBlock Text="说明：采用累计预扣法。系统假设每月工资相同，自动计算 1 月至当前月的累计，"
                                   Style="{StaticResource TextSmall}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock Text="得出当前月个税。跨月后请手动更新月份以保持准确。"
                                   Style="{StaticResource TextSmall}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ══════ 分区 3：班制设置 ══════ -->
            <StackPanel Grid.Row="1" Visibility="{Binding SelectedPageIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=2}">
                <TextBlock Text="班制设置" Style="{StaticResource TextPageTitle}" Margin="0,0,0,16"/>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="班制预设" Style="{StaticResource TextCardTitle}" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox SelectedIndex="{Binding ShiftPresetIndex}" Width="220" Margin="0,0,12,0">
                                <ComboBoxItem Content="五天八小时双休"/>
                                <ComboBoxItem Content="大小周"/>
                                <ComboBoxItem Content="六天工作制"/>
                                <ComboBoxItem Content="每日十小时"/>
                            </ComboBox>
                            <Button Content="应用预设" Style="{StaticResource ButtonPrimary}"
                                    Command="{Binding ApplyShiftPresetCommand}" Padding="16,6"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="工作时间" Style="{StaticResource TextCardTitle}" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="上班时间（HH:mm）" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding WorkStartText}" Width="120" HorizontalAlignment="Left"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="下班时间（HH:mm）" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding WorkEndText}" Width="120" HorizontalAlignment="Left"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="午休开始（HH:mm）" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding LunchStartText}" Width="120" HorizontalAlignment="Left"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="午休结束（HH:mm）" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding LunchEndText}" Width="120" HorizontalAlignment="Left"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="月计薪天数" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding MonthlyPayDays}" Width="120" HorizontalAlignment="Left"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="日计薪小时" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding DailyPayHours}" Width="120" HorizontalAlignment="Left"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="每周工作日" Style="{StaticResource TextCardTitle}" Margin="0,0,0,12"/>
                        <WrapPanel>
                            <CheckBox Content="周一" IsChecked="{Binding MondayChecked}" Margin="0,0,16,8"/>
                            <CheckBox Content="周二" IsChecked="{Binding TuesdayChecked}" Margin="0,0,16,8"/>
                            <CheckBox Content="周三" IsChecked="{Binding WednesdayChecked}" Margin="0,0,16,8"/>
                            <CheckBox Content="周四" IsChecked="{Binding ThursdayChecked}" Margin="0,0,16,8"/>
                            <CheckBox Content="周五" IsChecked="{Binding FridayChecked}" Margin="0,0,16,8"/>
                            <CheckBox Content="周六" IsChecked="{Binding SaturdayChecked}" Margin="0,0,16,8"/>
                            <CheckBox Content="周日" IsChecked="{Binding SundayChecked}" Margin="0,0,16,8"/>
                        </WrapPanel>

                        <Separator Background="{StaticResource BorderLineBrush}" Margin="0,8"/>

                        <CheckBox Content="启用大小周（大周双休，小周按小周工作日）"
                                  IsChecked="{Binding AlternateWeekEnabled}" Margin="0,0,0,8"/>
                        <CheckBox Content="锚点周为大周" IsChecked="{Binding AnchorWeekIsBig}"
                                  IsEnabled="{Binding AlternateWeekEnabled}" Margin="0,0,0,8"/>
                        <TextBlock Text="锚点周默认为首次运行所在周，用于推算大小周循环。"
                                   Style="{StaticResource TextSmall}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ══════ 分区 4：摸鱼按钮 ══════ -->
            <StackPanel Grid.Row="1" Visibility="{Binding SelectedPageIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=3}">
                <TextBlock Text="摸鱼按钮与历史" Style="{StaticResource TextPageTitle}" Margin="0,0,0,16"/>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <CheckBox Content="启用摸鱼历史记录（只存本地，不上传）"
                                  IsChecked="{Binding MuyuHistoryEnabled}" Margin="0,0,0,12"/>

                        <TextBlock Text="摸鱼按钮列表" Style="{StaticResource TextCardTitle}" Margin="0,8,0,12"/>

                        <ItemsControl ItemsSource="{Binding MuyuButtons}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding Emoji}" Margin="0,0,8,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding Label}" Margin="0,0,8,0"/>
                                        <Button Grid.Column="2" Content="删除" Style="{StaticResource ButtonDanger}"
                                                Command="{Binding DataContext.RemoveMuyuButtonCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Padding="12,4"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Background="{StaticResource BorderLineBrush}" Margin="0,12"/>

                        <TextBlock Text="添加新按钮" Style="{StaticResource TextLabel}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding NewMuyuEmoji}" Width="60" Margin="0,0,8,0"/>
                            <TextBox Text="{Binding NewMuyuLabel}" Width="180" Margin="0,0,8,0"/>
                            <Button Content="+ 添加" Style="{StaticResource ButtonPrimary}"
                                    Command="{Binding AddMuyuButtonCommand}" Padding="16,6"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ══════ 分区 5：政策参数 ══════ -->
            <StackPanel Grid.Row="1" Visibility="{Binding SelectedPageIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=4}">
                <TextBlock Text="政策参数" Style="{StaticResource TextPageTitle}" Margin="0,0,0,16"/>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="社保参数（深圳 2026 示例值，可自行更新）" Style="{StaticResource TextCardTitle}"/>
                            <Button Content="恢复默认" Style="{StaticResource ButtonGhost}"
                                    Command="{Binding RestoreDefaultsCommand}"
                                    HorizontalAlignment="Right" Padding="12,4"/>
                        </Grid>

                        <TextBlock Text="养老保险" Style="{StaticResource TextLabel}" Margin="0,8,0,8"/>
                        <WrapPanel>
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Text="比例（%）" Style="{StaticResource TextSmall}"/>
                                <TextBox Text="{Binding PensionRatePercent}" Width="90"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Text="基数下限" Style="{StaticResource TextSmall}"/>
                                <TextBox Text="{Binding PensionMin}" Width="110"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Text="基数上限" Style="{StaticResource TextSmall}"/>
                                <TextBox Text="{Binding PensionMax}" Width="110"/>
                            </StackPanel>
                        </WrapPanel>

                        <TextBlock Text="医疗保险" Style="{StaticResource TextLabel}" Margin="0,12,0,8"/>
                        <WrapPanel>
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Text="深圳一档比例（%）" Style="{StaticResource TextSmall}"/>
                                <TextBox Text="{Binding MedicalTier1RatePercent}" Width="90"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Text="深圳二档比例（%）" Style="{StaticResource TextSmall}"/>
                                <TextBox Text="{Binding MedicalTier2RatePercent}" Width="90"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Text="基数下限" Style="{StaticResource TextSmall}"/>
                                <TextBox Text="{Binding MedicalMin}" Width="110"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Text="基数上限" Style="{StaticResource TextSmall}"/>
                                <TextBox Text="{Binding MedicalMax}" Width="110"/>
                            </StackPanel>
                        </WrapPanel>

                        <TextBlock Text="失业保险" Style="{StaticResource TextLabel}" Margin="0,12,0,8"/>
                        <WrapPanel>
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Text="比例（%）" Style="{StaticResource TextSmall}"/>
                                <TextBox Text="{Binding UnemploymentRatePercent}" Width="90"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Text="基数下限" Style="{StaticResource TextSmall}"/>
                                <TextBox Text="{Binding UnemploymentMin}" Width="110"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Text="基数上限" Style="{StaticResource TextSmall}"/>
                                <TextBox Text="{Binding UnemploymentMax}" Width="110"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="节假日（强制休息，不计薪）" Style="{StaticResource TextCardTitle}" Margin="0,0,0,8"/>
                        <TextBlock Text="预置 2026 年法定节假日，连休安排为推定值，请以国务院办公厅通知为准，可自行增删。"
                                   Style="{StaticResource TextSmall}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <ItemsControl ItemsSource="{Binding HolidayDates}" MaxHeight="240">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Date, StringFormat=yyyy-MM-dd}"
                                                   Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                   Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" Content="删除" Style="{StaticResource ButtonDanger}"
                                                Command="{Binding DataContext.RemoveHolidayCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Padding="10,3"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Background="{StaticResource BorderLineBrush}" Margin="0,12"/>

                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding NewHolidayDate}" Width="140" Margin="0,0,8,0"
                                     ToolTip="格式：yyyy-MM-dd"/>
                            <TextBox Text="{Binding NewHolidayName}" Width="140" Margin="0,0,8,0"
                                     ToolTip="节日名称"/>
                            <Button Content="+ 添加" Style="{StaticResource ButtonPrimary}"
                                    Command="{Binding AddHolidayCommand}" Padding="16,6"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 补班日 -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="补班日（国家调休补班，正常上班计薪）" Style="{StaticResource TextCardTitle}" Margin="0,0,0,8"/>
                        <TextBlock Text="调休补班的周末按正常工作日计算工资，不做强制休息。预置 2026 年推定补班日，请以国务院办公厅通知为准，可自行增删。"
                                   Style="{StaticResource TextSmall}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <ItemsControl ItemsSource="{Binding MakeupWorkDays}" MaxHeight="200">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Date, StringFormat=yyyy-MM-dd}"
                                                   Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                   Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" Content="删除" Style="{StaticResource ButtonDanger}"
                                                Command="{Binding DataContext.RemoveMakeupDayCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Padding="10,3"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Background="{StaticResource BorderLineBrush}" Margin="0,12"/>

                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding NewMakeupDate}" Width="140" Margin="0,0,8,0"
                                     ToolTip="格式：yyyy-MM-dd"/>
                            <TextBox Text="{Binding NewMakeupName}" Width="140" Margin="0,0,8,0"
                                     ToolTip="补班名称"/>
                            <Button Content="+ 添加" Style="{StaticResource ButtonPrimary}"
                                    Command="{Binding AddMakeupDayCommand}" Padding="16,6"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ══════ 分区 6：更新 ══════ -->
            <StackPanel Grid.Row="1" Visibility="{Binding SelectedPageIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=5}">
                <TextBlock Text="更新" Style="{StaticResource TextPageTitle}" Margin="0,0,0,16"/>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="当前版本" Style="{StaticResource TextCardTitle}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Update.CurrentVersionText}"
                                       FontFamily="{StaticResource FontFamilyNumber}"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource MoneyBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- 程序位置与一键更新可用性（常驻状态，随时可查） -->
                        <Border Background="{StaticResource BgSubtleBrush}"
                                CornerRadius="12" Padding="14,12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="程序位置" Style="{StaticResource TextSmall}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding Update.InstallDirPath}"
                                           Style="{StaticResource TextLabel}"
                                           TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding Update.InstallDirStatusText}"
                                           Style="{StaticResource TextSmall}"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <CheckBox Content="检查新版本（关闭后应用完全不联网）"
                                  IsChecked="{Binding UpdateCheckEnabled}" Margin="0,0,0,14"/>

                        <TextBlock Text="版本清单地址（留空则使用官方地址；如需完全停用检查，请关闭上方开关）"
                                   Style="{StaticResource TextSmall}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding UpdateCheckUrl, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding UpdateCheckEnabled}"
                                 Margin="0,0,0,14"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="立即检查更新"
                                    Style="{StaticResource ButtonPrimary}"
                                    Command="{Binding CheckUpdateNowCommand}"
                                    IsEnabled="{Binding UpdateCheckEnabled}"
                                    Padding="20,9"/>
                            <!-- 检查失败时的兜底：改用浏览器访问官网手动下载 -->
                            <Button Content="在浏览器中打开官网"
                                    Style="{StaticResource ButtonGhost}"
                                    Command="{Binding Update.OpenDownloadPageCommand}"
                                    Padding="16,9" Margin="8,0,0,0"
                                    Visibility="{Binding Update.HasCheckError, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Update.CheckResultText}"
                                   Style="{StaticResource TextSmall}"
                                   TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="📡 关于联网" Style="{StaticResource TextCardTitle}" Margin="0,0,0,8"/>
                        <TextBlock Text="本应用不会上传任何数据。开启「检查新版本」后，启动时会请求上面的版本清单（几百字节）以判断是否有更新；下载安装包只在你点击「立即更新」后发生。"
                                   Style="{StaticResource TextLabel}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <TextBlock Text="除更新检查外，应用其余功能完全离线运行。"
                                   Style="{StaticResource TextLabel}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ══════ 分区 7：关于 ══════ -->
            <StackPanel Grid.Row="1" Visibility="{Binding SelectedPageIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=6}">
                <TextBlock Text="关于 SalaryTicker" Style="{StaticResource TextPageTitle}" Margin="0,0,0,16"/>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="🧭 关于参数" Style="{StaticResource TextCardTitle}" Margin="0,0,0,8"/>
                        <TextBlock Text="本工具内置深圳市的社保、公积金、个税参数。其他城市可在「设置 → 政策参数」中按当地政策自行调整。"
                                   Style="{StaticResource TextLabel}" TextWrapping="Wrap"/>
                        <TextBlock Text="如有疑问或建议，欢迎联系 Lee 老师：leemail208@163.com"
                                   Style="{StaticResource TextLabel}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="🔧 参数可配置" Style="{StaticResource TextCardTitle}" Margin="0,0,0,8"/>
                        <TextBlock Text="社保基数上下限、公积金比例、个税税率等参数已做成可配置项，政策调整后可在设置中手动更新。"
                                   Style="{StaticResource TextLabel}" TextWrapping="Wrap"/>
                        <TextBlock Text="其他扣款（企业年金等）按税后扣减口径计入。"
                                   Style="{StaticResource TextLabel}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="📌 计算结果仅供参考" Style="{StaticResource TextCardTitle}" Margin="0,0,0,8"/>
                        <TextBlock Text="计算结果仅供参考，以实际工资条为准。愿你的付出都有回响，休息也理直气壮。"
                                   Style="{StaticResource TextLabel}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="💚 写在最后" Style="{StaticResource TextCardTitle}" Margin="0,0,0,8"/>
                        <TextBlock Text="希望每一个努力生活的人，都能被好好对待。"
                                   Style="{StaticResource TextLabel}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="Lee 老师倡导全行业按法休息，不恶意内卷、不形式加班。这个计算器也会在节假日强制休息，不计算工资和加班费。"
                                   Style="{StaticResource TextLabel}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="启动页" Style="{StaticResource TextCardTitle}" Margin="0,0,0,12"/>
                        <CheckBox Content="每次启动显示温馨提示页" IsChecked="{Binding ShowSplashOnStartup}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <Grid>
                        <TextBlock Text="版本" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Update.CurrentVersionText}"
                                   FontFamily="{StaticResource FontFamilyNumber}"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource MoneyBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>
          </Grid>
        </ScrollViewer>

        <!-- ══════════ 底部按钮栏 ══════════ -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderLineBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource ButtonGhost}"
                        Command="{Binding CancelCommand}"
                        Padding="24,10" Margin="0,0,12,0"/>
                <Button Content="保存" Style="{StaticResource ButtonPrimary}"
                        Command="{Binding SaveCommand}"
                        Padding="32,10"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
