<!-- ============================================================================
     文件名：SplashWindow.xaml
     功能描述：启动提示页（Warm：暖白卡片、衬线品牌、三段说明、一个开始按钮）
     ============================================================================ -->
<Window x:Class="SalaryTicker.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/SalaryTicker.ico"
        xmlns:vm="clr-namespace:SalaryTicker.ViewModels"
        Title="SalaryTicker - 实时计算器"
        Width="880" Height="460"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.DataContext>
        <vm:SplashViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <Style TargetType="CheckBox" BasedOn="{StaticResource WCheckBoxStyle}"/>
        <Style x:Key="SplashPrimary" TargetType="Button" BasedOn="{StaticResource WPrimaryButtonStyle}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.3"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border Background="{StaticResource WSurfaceBrush}"
            CornerRadius="18"
            BorderBrush="{StaticResource WBorderBrush}"
            BorderThickness="1"
            Margin="18">
        <Border.Effect>
            <DropShadowEffect Color="#5A3C28"
                              BlurRadius="30" ShadowDepth="6" Opacity="0.14"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.RowSpan="2" Background="{StaticResource WHeroGlowCoralBrush}"/>
            <Border Grid.RowSpan="2" Background="{StaticResource WHeroGlowGreenBrush}"/>

            <Border Grid.Row="0" Background="{StaticResource WBrandGradientBrush}"
                    CornerRadius="18,18,0,0"/>

            <Grid Grid.Row="1" Margin="40,30,40,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 品牌 -->
                <StackPanel Grid.Row="0">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Assets/icon-preview-48.png"
                               Width="34" Height="34"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               VerticalAlignment="Center"/>
                        <TextBlock Text="SalaryTicker"
                                   FontFamily="{StaticResource WFontDisplay}"
                                   FontSize="26" FontWeight="SemiBold"
                                   Foreground="{StaticResource WInkStrongBrush}"
                                   Margin="12,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="实时计算器" FontSize="12"
                                   Foreground="{StaticResource WMutedBrush}"
                                   Margin="10,4,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border Height="1" Background="{StaticResource WBorderBrush}" Margin="0,18,0,0"/>
                </StackPanel>

                <!-- 三段说明 -->
                <StackPanel Grid.Row="1" Margin="0,18,0,0">
                    <TextBlock Text="使用说明" Style="{StaticResource WPanelTitleStyle}"/>
                    <Border Background="{StaticResource WGreenSoftBrush}"
                            BorderBrush="{StaticResource WGreenBrush}"
                            BorderThickness="2,0,0,0" CornerRadius="6"
                            Padding="12,9" Margin="0,10,0,0">
                        <TextBlock Text="内置深圳社保、公积金与个税参数；其他城市可在「设置 → 政策参数」中调整。"
                                   Style="{StaticResource WBodyStyle}"/>
                    </Border>
                    <Border Background="{StaticResource WAmberSoftBrush}"
                            BorderBrush="{StaticResource WAmberBrush}"
                            BorderThickness="2,0,0,0" CornerRadius="6"
                            Padding="12,9" Margin="0,8,0,0">
                        <TextBlock Text="应用不上传数据。开启更新检查后，启动时只请求版本清单；下载只在你点「立即更新」后发生。"
                                   Style="{StaticResource WBodyStyle}"/>
                    </Border>
                    <Border Background="{StaticResource WBlueSoftBrush}"
                            BorderBrush="{StaticResource WBlueBrush}"
                            BorderThickness="2,0,0,0" CornerRadius="6"
                            Padding="12,9" Margin="0,8,0,0">
                        <TextBlock Text="计算结果仅供参考，以实际工资条为准。"
                                   Style="{StaticResource WBodyStyle}"/>
                    </Border>
                </StackPanel>

                <!-- 确认区 -->
                <StackPanel Grid.Row="2">
                    <CheckBox Content="下次不再显示"
                              IsChecked="{Binding DontShowAgain}"
                              Margin="0,0,0,14"/>
                    <Button Content="开始使用"
                            Style="{StaticResource SplashPrimary}"
                            Command="{Binding ConfirmCommand}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
