<!-- ============================================================================
     文件名：SplashWindow.xaml
     功能描述：启动提示页（B 流水台账：一张纸、三段说明、一个开始按钮）
     ============================================================================ -->
<Window x:Class="SalaryTicker.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/SalaryTicker.ico"
        xmlns:vm="clr-namespace:SalaryTicker.ViewModels"
        Title="SalaryTicker - 实时计算器"
        Width="880" Height="460"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.DataContext>
        <vm:SplashViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <Style TargetType="CheckBox" BasedOn="{StaticResource BCheckBoxStyle}"/>

        <Style x:Key="SplashPrimary" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BInkBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource BPaperBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource BFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding Background}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2E3A35"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.3"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border Background="{StaticResource BWhiteBrush}"
            CornerRadius="4"
            BorderBrush="{StaticResource BControlBrush}"
            BorderThickness="1"
            Margin="18">
        <Border.Effect>
            <DropShadowEffect Color="#1F2724"
                              BlurRadius="32" ShadowDepth="8" Opacity="0.18"/>
        </Border.Effect>

        <Grid Margin="40,32,40,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 品牌 -->
            <StackPanel Grid.Row="0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="30" Height="30" CornerRadius="2"
                            Background="{StaticResource BInkBrush}"
                            VerticalAlignment="Center">
                        <TextBlock Text="¥" FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource BPaperBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="SalaryTicker" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource BInkBrush}"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="实时计算器" FontSize="12"
                               Foreground="{StaticResource BMutedBrush}"
                               Margin="10,4,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Border Height="1" Background="{StaticResource BRuleBrush}" Margin="0,20,0,0"/>
            </StackPanel>

            <!-- 三段说明 -->
            <StackPanel Grid.Row="1" Margin="0,20,0,0">
                <TextBlock Text="使用说明" Style="{StaticResource BSectionTitleStyle}"/>
                <TextBlock Text="内置深圳社保、公积金与个税参数；其他城市可在「设置 → 政策参数」中调整。"
                           FontSize="13"
                           Foreground="{StaticResource BMutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"/>
                <TextBlock Text="应用不上传数据。开启更新检查后，启动时只请求版本清单；下载只在你点「立即更新」后发生。"
                           FontSize="13"
                           Foreground="{StaticResource BMutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"/>
                <TextBlock Text="计算结果仅供参考，以实际工资条为准。"
                           FontSize="13"
                           Foreground="{StaticResource BMutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"/>
            </StackPanel>

            <!-- 确认区 -->
            <StackPanel Grid.Row="2">
                <CheckBox Content="下次不再显示"
                          IsChecked="{Binding DontShowAgain}"
                          Margin="0,0,0,14"/>
                <Button Content="开始使用"
                        Style="{StaticResource SplashPrimary}"
                        Command="{Binding ConfirmCommand}"
                        HorizontalAlignment="Stretch"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
