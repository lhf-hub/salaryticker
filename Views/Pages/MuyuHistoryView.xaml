<!-- ============================================================================
     文件名：MuyuHistoryView.xaml
     功能描述：Warm 风格的摸鱼历史（汇总卡 + 记录卡 + 口径说明）
     ============================================================================ -->
<UserControl x:Class="SalaryTicker.Views.Pages.MuyuHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SalaryTicker.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:MuyuHistoryViewModel}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="BTableHead" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource WFontBody}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource WSubtleBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="BTableHeadLeft" TargetType="TextBlock" BasedOn="{StaticResource BTableHead}">
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="BRowLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource WFontBody}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource WMutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>
        <Style x:Key="BRowValueStyle" TargetType="TextBlock" BasedOn="{StaticResource WNumberStyle}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="BTableMoney" TargetType="TextBlock" BasedOn="{StaticResource BRowValueStyle}">
            <Setter Property="Foreground" Value="{StaticResource WGreenBrush}"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="30,20,30,18">
        <StackPanel>

            <!-- 顶部：返回 + 标题 + 清空 -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource WTopButtonStyle}"
                        Command="{Binding DataContext.BackToDashboardCommand,
                                  RelativeSource={RelativeSource AncestorType=Window}}"
                        Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconBack}"
                              Fill="{StaticResource WMutedBrush}"
                              Width="15" Height="15" Stretch="Uniform"
                              VerticalAlignment="Center"/>
                        <TextBlock Text="返回" FontSize="13"
                                   Foreground="{StaticResource WInkBrush}"
                                   Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <TextBlock Grid.Column="1" Text="摸鱼统计"
                           Style="{StaticResource WPageTitleStyle}"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="2"
                        Style="{StaticResource WContentButtonStyle}"
                        Command="{Binding ClearAllCommand}"
                        Padding="12,7">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconTrash}"
                              Fill="{StaticResource WCoralStrongBrush}"
                              Width="14" Height="14" Stretch="Uniform"
                              VerticalAlignment="Center"/>
                        <TextBlock Text="一键清空" FontSize="13"
                                   Foreground="{StaticResource WCoralStrongBrush}"
                                   Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <TextBlock Text="{Binding FunnyText}"
                       Style="{StaticResource WBodyStyle}"
                       Margin="0,0,0,14"/>

            <!-- 汇总卡：今日 / 本周 / 本月 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource WStatCardStyle}"
                        Background="{StaticResource WGreenSoftBrush}"
                        BorderBrush="#B6DCC9">
                    <StackPanel>
                        <Border Height="2" Background="{StaticResource WGreenBrush}"
                                CornerRadius="1" Margin="0,0,0,10"/>
                        <TextBlock Text="今日" Style="{StaticResource WStatLabelStyle}"/>
                        <TextBlock Text="{Binding TodayCostText}"
                                   Style="{StaticResource WStatValueStyle}"
                                   FontSize="30" Foreground="{StaticResource WGreenStrongBrush}"
                                   Margin="0,4,0,2"/>
                        <TextBlock Style="{StaticResource WSmallStyle}" TextWrapping="NoWrap">
                            <Run Text="{Binding TodayCount, Mode=OneWay}"/>
                            <Run Text=" 次 · "/>
                            <Run Text="{Binding TodayDurationText, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource WStatCardStyle}"
                        Background="{StaticResource WAmberSoftBrush}"
                        BorderBrush="#EBCFAA">
                    <StackPanel>
                        <Border Height="2" Background="{StaticResource WAmberBrush}"
                                CornerRadius="1" Margin="0,0,0,10"/>
                        <TextBlock Text="本周" Style="{StaticResource WStatLabelStyle}"/>
                        <TextBlock Text="{Binding WeekCostText}"
                                   Style="{StaticResource WStatValueStyle}"
                                   FontSize="30" Foreground="{StaticResource WAmberStrongBrush}"
                                   Margin="0,4,0,2"/>
                        <TextBlock Style="{StaticResource WSmallStyle}" TextWrapping="NoWrap">
                            <Run Text="{Binding WeekCount, Mode=OneWay}"/>
                            <Run Text=" 次 · "/>
                            <Run Text="{Binding WeekDurationText, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource WStatCardStyle}"
                        Background="{StaticResource WBlueSoftBrush}"
                        BorderBrush="#B8D2E5">
                    <StackPanel>
                        <Border Height="2" Background="{StaticResource WBlueBrush}"
                                CornerRadius="1" Margin="0,0,0,10"/>
                        <TextBlock Text="本月" Style="{StaticResource WStatLabelStyle}"/>
                        <TextBlock Text="{Binding MonthCostText}"
                                   Style="{StaticResource WStatValueStyle}"
                                   FontSize="30" Foreground="{StaticResource WBlueStrongBrush}"
                                   Margin="0,4,0,2"/>
                        <TextBlock Style="{StaticResource WSmallStyle}" TextWrapping="NoWrap">
                            <Run Text="{Binding MonthCount, Mode=OneWay}"/>
                            <Run Text=" 次 · "/>
                            <Run Text="{Binding MonthDurationText, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 历史记录 -->
            <Border Style="{StaticResource WPanelCardStyle}" Margin="0,14,0,0" Padding="18">
                <StackPanel>
                    <TextBlock Text="历史记录" Style="{StaticResource WPanelTitleStyle}"
                               Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="日期" Style="{StaticResource BTableHeadLeft}"/>
                        <TextBlock Grid.Column="1" Text="项目" Style="{StaticResource BTableHeadLeft}"/>
                        <TextBlock Grid.Column="2" Text="时间段" Style="{StaticResource BTableHeadLeft}"/>
                        <TextBlock Grid.Column="3" Text="时长" Style="{StaticResource BTableHead}"/>
                        <TextBlock Grid.Column="4" Text="白赚" Style="{StaticResource BTableHead}"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource WBorderBrush}"/>

                    <ItemsControl ItemsSource="{Binding Records}" MaxHeight="300" Margin="0,2,0,0">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource WBorderBrush}"
                                        BorderThickness="0,0,0,1" Padding="0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding DateText}"
                                                   Style="{StaticResource BRowLabelStyle}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ButtonLabel}"
                                                   Style="{StaticResource BRowLabelStyle}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding TimeRangeText}"
                                                   Style="{StaticResource BRowLabelStyle}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding DurationText}"
                                                   Style="{StaticResource BRowValueStyle}"
                                                   ToolTip="{Binding DurationTooltip}"/>
                                        <TextBlock Grid.Column="4" Text="{Binding CostText}"
                                                   Style="{StaticResource BTableMoney}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="还没有摸鱼记录。"
                               Foreground="{StaticResource WSubtleBrush}"
                               Margin="0,16,0,6">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource WSmallStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Records.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 口径与隐私 -->
            <Border Height="1" Background="{StaticResource WBorderBrush}" Margin="0,14,0,0"/>
            <TextBlock Text="时长与白赚只统计工作时段内的部分（午休、下班后、节假日不计）。"
                       Style="{StaticResource WSmallStyle}"
                       Margin="0,8,0,0"/>
            <TextBlock Text="摸鱼历史只存本地，不上传。"
                       Style="{StaticResource WSmallStyle}"
                       Margin="0,4,0,0"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
