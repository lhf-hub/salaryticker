<!-- ============================================================================
     文件名：MuyuHistoryView.xaml
     功能描述：摸鱼历史页面（今日/本周/本月汇总 + 记录列表 + 清空）
     ============================================================================ -->
<UserControl x:Class="SalaryTicker.Views.Pages.MuyuHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SalaryTicker.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:MuyuHistoryViewModel}"
             mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>

            <!-- 顶部：返回 + 标题 -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource ButtonGhost}"
                        Command="{Binding DataContext.BackToDashboardCommand,
                                  RelativeSource={RelativeSource AncestorType=Window}}"
                        Padding="12,6"
                        Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconBack}"
                              Fill="{StaticResource TextPrimaryBrush}"
                              Width="16" Height="16" Stretch="Uniform"
                              VerticalAlignment="Center"/>
                        <TextBlock Text="返回" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <TextBlock Grid.Column="1" Text="🐟 摸鱼统计"
                           Style="{StaticResource TextPageTitle}"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="2"
                        Style="{StaticResource ButtonDanger}"
                        Command="{Binding ClearAllCommand}"
                        Padding="16,8">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconTrash}"
                              Fill="{StaticResource DangerBrush}"
                              Width="16" Height="16" Stretch="Uniform"
                              VerticalAlignment="Center"/>
                        <TextBlock Text="一键清空" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 幽默文案 -->
            <Border Background="{StaticResource WarnSoftBrush}"
                    CornerRadius="12"
                    Padding="16,12"
                    Margin="0,0,0,16">
                <TextBlock Text="{Binding FunnyText}"
                           Foreground="{StaticResource WarnBrush}"
                           FontSize="15"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- 三张汇总卡片 -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 今日 -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="今日" Style="{StaticResource TextCardTitle}" Margin="0,0,0,12"/>
                        <TextBlock Style="{StaticResource TextLabel}">
                            <Run Text="次数："/><Run Text="{Binding TodayCount, Mode=OneWay}" FontWeight="Bold"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource TextLabel}" Margin="0,4,0,0">
                            <Run Text="时长："/><Run Text="{Binding TodayDurationText, Mode=OneWay}" FontWeight="Bold"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource TextLabel}" Margin="0,4,0,0">
                            <Run Text="白赚："/><Run Text="{Binding TodayCostText, Mode=OneWay}" FontWeight="Bold"
                                                     Foreground="{Binding RelativeSource={RelativeSource AncestorType=TextBlock}, Path=Foreground}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- 本周 -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="本周" Style="{StaticResource TextCardTitle}" Margin="0,0,0,12"/>
                        <TextBlock Style="{StaticResource TextLabel}">
                            <Run Text="次数："/><Run Text="{Binding WeekCount, Mode=OneWay}" FontWeight="Bold"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource TextLabel}" Margin="0,4,0,0">
                            <Run Text="时长："/><Run Text="{Binding WeekDurationText, Mode=OneWay}" FontWeight="Bold"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource TextLabel}" Margin="0,4,0,0">
                            <Run Text="白赚："/><Run Text="{Binding WeekCostText, Mode=OneWay}" FontWeight="Bold"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- 本月 -->
                <Border Grid.Column="4" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="本月" Style="{StaticResource TextCardTitle}" Margin="0,0,0,12"/>
                        <TextBlock Style="{StaticResource TextLabel}">
                            <Run Text="次数："/><Run Text="{Binding MonthCount, Mode=OneWay}" FontWeight="Bold"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource TextLabel}" Margin="0,4,0,0">
                            <Run Text="时长："/><Run Text="{Binding MonthDurationText, Mode=OneWay}" FontWeight="Bold"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource TextLabel}" Margin="0,4,0,0">
                            <Run Text="白赚："/><Run Text="{Binding MonthCostText, Mode=OneWay}" FontWeight="Bold"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 记录列表 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="历史记录" Style="{StaticResource TextCardTitle}" Margin="0,0,0,12"/>

                    <!-- 表头 -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="日期" Style="{StaticResource TextSmall}"/>
                        <TextBlock Grid.Column="1" Text="项目" Style="{StaticResource TextSmall}"/>
                        <TextBlock Grid.Column="2" Text="时间段" Style="{StaticResource TextSmall}"/>
                        <TextBlock Grid.Column="3" Text="时长" Style="{StaticResource TextSmall}"/>
                        <TextBlock Grid.Column="4" Text="白赚" Style="{StaticResource TextSmall}"/>
                    </Grid>

                    <Separator Background="{StaticResource BorderLineBrush}" Margin="0,0,0,8"/>

                    <!-- 记录项 -->
                    <ItemsControl ItemsSource="{Binding Records}" MaxHeight="320">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding DateText}" Style="{StaticResource TextLabel}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ButtonLabel}" Style="{StaticResource TextLabel}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding TimeRangeText}" Style="{StaticResource TextLabel}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding DurationText}"
                                               Style="{StaticResource TextLabel}"
                                               ToolTip="{Binding DurationTooltip}"/>
                                    <TextBlock Grid.Column="4" Text="{Binding CostText}"
                                               Foreground="{StaticResource WarnBrush}" FontWeight="SemiBold"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="暂无记录"
                               HorizontalAlignment="Center"
                               Margin="0,24,0,24">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextSmall}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Records.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 隐私与口径说明 -->
            <TextBlock Text="时长与白赚只统计工作时段内的部分（午休、下班后、节假日不计）。"
                       Style="{StaticResource TextSmall}"
                       TextAlignment="Center"
                       Margin="0,16,0,0"/>
            <TextBlock Text="🔒 摸鱼历史只存本地，不上传。"
                       Style="{StaticResource TextSmall}"
                       TextAlignment="Center"
                       Margin="0,6,0,0"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
