<!-- ============================================================================
     文件名：DashboardView.xaml
     功能描述：主仪表盘（本月已赚大数字 + 今日/小时 + 倒计时 + 摸鱼按钮）
     暖阳浅色 · 简约 Q 感：白卡片、大圆角、薄荷绿金额、蜜桃橙摸鱼
     ============================================================================ -->
<UserControl x:Class="SalaryTicker.Views.Pages.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SalaryTicker.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,20">
        <StackPanel>

            <!-- ══════════ 大卡片：本月已赚 ══════════ -->
            <Border Style="{StaticResource Card}" Padding="28,24" Margin="0,0,0,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="🌱" FontSize="15" VerticalAlignment="Center"/>
                        <TextBlock Text="本月已赚" Style="{StaticResource TextLabel}"
                                   Margin="7,0,0,0" VerticalAlignment="Center" FontSize="14"/>
                    </StackPanel>

                    <!-- 大数字：薄荷绿 + 每秒脉冲变亮 -->
                    <TextBlock x:Name="MonthEarnedBlock"
                               Text="{Binding MonthEarnedText}"
                               Style="{StaticResource NumberHuge}"
                               Margin="0,10,0,14"
                               HorizontalAlignment="Center">
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                                                        To="#34D399" Duration="0:0:0.09" AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>

                    <!-- 本月进度 -->
                    <ProgressBar Value="{Binding MonthProgress, Mode=OneWay}"
                                 Minimum="0" Maximum="1"
                                 Height="10" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="本月进度" Style="{StaticResource TextSmall}"/>
                        <TextBlock Text="{Binding MonthProgressText}"
                                   Style="{StaticResource TextSmall}"
                                   HorizontalAlignment="Right"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Grid>

                    <!-- 计算摘要：圆角小胶囊 -->
                    <Border Background="{StaticResource BgSubtleBrush}"
                            CornerRadius="999"
                            Padding="16,8"
                            HorizontalAlignment="Center">
                        <TextBlock Text="{Binding SalarySummary}"
                                   Style="{StaticResource TextSmall}"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ══════════ 两个中卡片：今日已赚 | 当前小时已赚 ══════════ -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="24,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="☀️" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="今日已赚" Style="{StaticResource TextLabel}"
                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TodayEarnedText}"
                                   Style="{StaticResource NumberLarge}"
                                   Margin="0,8,0,0"
                                   Foreground="{StaticResource MoneyBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="24,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="⏱️" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="当前小时已赚" Style="{StaticResource TextLabel}"
                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding HourEarnedText}"
                                   Style="{StaticResource NumberMedium}"
                                   Margin="0,10,0,0"
                                   Foreground="{StaticResource MoneyBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══════════ 状态 + 倒计时 ══════════ -->
            <Border Style="{StaticResource Card}" Padding="24,18" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 倒计时 -->
                    <StackPanel Grid.Column="0" MinWidth="150">
                        <TextBlock Text="{Binding CountdownLabel}" Style="{StaticResource TextSmall}"/>
                        <TextBlock Text="{Binding CountdownText}"
                                   FontFamily="{StaticResource FontFamilyNumber}"
                                   FontSize="30" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- 状态文案 -->
                    <Border Grid.Column="1"
                            Background="{StaticResource MoneySoftBrush}"
                            CornerRadius="999"
                            Padding="20,12"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusText}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MoneyBrush}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ══════════ 摸鱼区 ══════════ -->
            <Border Style="{StaticResource Card}" Padding="24,18"
                    Visibility="{Binding IsMuyuVisible, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="🐟" FontSize="15" VerticalAlignment="Center"/>
                        <TextBlock Text="摸鱼一下" Style="{StaticResource TextLabel}"
                                   Margin="7,0,0,0" VerticalAlignment="Center" FontSize="14"/>
                        <TextBlock Text="工资照常涨，只是看看花了老板多少钱"
                                   Style="{StaticResource TextSmall}"
                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 摸鱼状态气泡 -->
                    <Border Background="{StaticResource WarnSoftBrush}"
                            CornerRadius="16"
                            Padding="16,10"
                            Margin="0,0,0,14"
                            Visibility="{Binding IsMuyuRunning, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding MuyuStatusText}"
                                   Foreground="#8A5A2B"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                    </Border>

                    <!-- 非工作时段禁用提示：这段时间本来就归你 -->
                    <Border Background="{StaticResource InfoSoftBrush}"
                            CornerRadius="16"
                            Padding="16,10"
                            Margin="0,0,0,14"
                            Visibility="{Binding IsMuyuEnabled, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="{Binding MuyuDisabledHint}"
                                   Foreground="{StaticResource InfoBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- 摸鱼按钮（蜜桃橙胶囊；非工作时段禁用） -->
                    <ItemsControl ItemsSource="{Binding MuyuButtons}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ButtonMuyu}"
                                        IsEnabled="{Binding DataContext.IsMuyuEnabled,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        Command="{Binding DataContext.MuyuClickCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Margin="0,0,12,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayText}" FontSize="15" VerticalAlignment="Center"/>
                                        <Border Background="#33FFFFFF"
                                                CornerRadius="999"
                                                Padding="8,3"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock FontSize="12" Foreground="#8A5A2B">
                                                <Run Text="{Binding ElapsedText, Mode=OneWay}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding CostText, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ══════════ 底部提示 ══════════ -->
            <TextBlock Text="Lee 老师倡导按法休息：不恶意内卷、不形式加班，节假日系统强制休息，不计工资与加班费。结果仅供参考，以实际工资条为准。"
                       Style="{StaticResource TextSmall}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,4,0,0"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
