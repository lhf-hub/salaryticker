<!-- ============================================================================
     文件名：DashboardView.xaml
     功能描述：B 流水台账方向的 Dashboard 纵向切片
     结构：月份上下文 → 总额双线 → 本月台账 → 今日 → 状态 → 摸鱼 → 免责
     ============================================================================ -->
<UserControl x:Class="SalaryTicker.Views.Pages.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SalaryTicker.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,18,32,10">
        <StackPanel>

            <!-- 月份上下文 -->
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding MonthContextText}"
                           Style="{StaticResource BLabelStyle}"/>
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding PayDaysContextText}"
                           Style="{StaticResource BLabelStyle}"/>
            </DockPanel>

            <!-- 总额 -->
            <DockPanel LastChildFill="False" Margin="0,14,0,0">
                <TextBlock DockPanel.Dock="Left"
                           Text="本月已赚"
                           FontSize="14"
                           Foreground="{StaticResource BMutedBrush}"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,7"/>
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding MonthEarnedText}"
                           Style="{StaticResource BHeroAmountStyle}"/>
            </DockPanel>

            <!-- 双线收总额 -->
            <StackPanel Margin="0,12,0,0">
                <Border Height="1" Background="{StaticResource BInkBrush}"/>
                <Border Height="1" Background="{StaticResource BInkBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 本月台账 -->
            <StackPanel Margin="0,10,0,0">
                <TextBlock Text="本月" Style="{StaticResource BSectionTitleStyle}"/>

                <Grid MinHeight="30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="本月进度" Style="{StaticResource BRowLabelStyle}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding PayDayTicks}" Width="220" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="4" Margin="1,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource BRuleBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFilled}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource BGreenBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding MonthProgressText}"
                                   Style="{StaticResource BRowValueStyle}"
                                   Margin="12,0,0,0"/>
                    </StackPanel>
                </Grid>

                <Grid MinHeight="30" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="还剩工作日" Style="{StaticResource BRowLabelStyle}"/>
                    <TextBlock Grid.Column="1" Text="{Binding RemainingWorkDaysText}" Style="{StaticResource BRowValueStyle}"/>
                </Grid>

                <Grid MinHeight="30" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="税后月薪" Style="{StaticResource BRowLabelStyle}"/>
                    <TextBlock Grid.Column="1" Text="{Binding AfterTaxMonthlyText}" Style="{StaticResource BRowValueStyle}"/>
                </Grid>

                <Grid MinHeight="30" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="日薪" Style="{StaticResource BRowLabelStyle}"/>
                    <TextBlock Grid.Column="1" Text="{Binding DailyRateText}" Style="{StaticResource BRowValueStyle}"/>
                </Grid>

                <Grid MinHeight="30" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="秒薪" Style="{StaticResource BRowLabelStyle}"/>
                    <TextBlock Grid.Column="1" Text="{Binding SecondRateText}" Style="{StaticResource BRowValueStyle}"/>
                </Grid>
            </StackPanel>

            <Border Height="1" Background="{StaticResource BRuleBrush}" Margin="0,8,0,0"/>

            <!-- 今日 -->
            <StackPanel Margin="0,8,0,0">
                <TextBlock Text="今日" Style="{StaticResource BSectionTitleStyle}"/>
                <Grid MinHeight="30" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="今日已赚" Style="{StaticResource BRowLabelStyle}"/>
                    <TextBlock Grid.Column="1" Text="{Binding TodayEarnedText}" Style="{StaticResource BRowValueStyle}"/>
                </Grid>
                <Grid MinHeight="30" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="当前小时已赚" Style="{StaticResource BRowLabelStyle}"/>
                    <TextBlock Grid.Column="1" Text="{Binding HourEarnedText}" Style="{StaticResource BRowValueStyle}"/>
                </Grid>
            </StackPanel>

            <Border Height="1" Background="{StaticResource BRuleBrush}" Margin="0,8,0,0"/>

            <!-- 状态 -->
            <StackPanel Margin="0,8,0,0">
                <TextBlock Text="状态" Style="{StaticResource BSectionTitleStyle}"/>
                <Grid MinHeight="30" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="工作状态" Style="{StaticResource BRowLabelStyle}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Style="{StaticResource BStatusDotStyle}" Margin="0,0,7,0"/>
                        <TextBlock Text="{Binding StatusShortText}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BInkBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
                <Grid MinHeight="30" Margin="0,2,0,0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CountdownText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding CountdownLabel}" Style="{StaticResource BRowLabelStyle}"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding CountdownText}"
                               Style="{StaticResource BRowValueStyle}"
                               FontSize="18"/>
                </Grid>
            </StackPanel>

            <!-- 摸鱼 -->
            <StackPanel Margin="0,8,0,0"
                        Visibility="{Binding IsMuyuVisible, Converter={StaticResource BoolToVisibility}}">
                <Border Height="1" Background="{StaticResource BRuleBrush}" Margin="0,0,0,8"/>
                <TextBlock Text="摸鱼" Style="{StaticResource BSectionTitleStyle}"/>

                <TextBlock Text="{Binding MuyuStatusShortText}"
                           FontSize="12"
                           Foreground="{StaticResource BWarnBrush}"
                           Margin="0,2,0,6"
                           TextWrapping="Wrap"
                           Visibility="{Binding IsMuyuRunning, Converter={StaticResource BoolToVisibility}}"/>

                <TextBlock Text="{Binding MuyuDisabledShortHint}"
                           FontSize="12"
                           Foreground="{StaticResource BMutedBrush}"
                           Margin="0,2,0,6"
                           TextWrapping="Wrap"
                           Visibility="{Binding IsMuyuEnabled, Converter={StaticResource InverseBoolToVisibility}}"/>

                <ItemsControl ItemsSource="{Binding MuyuButtons}" Margin="0,4,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource BMuyuButtonStyle}"
                                    IsEnabled="{Binding DataContext.IsMuyuEnabled,
                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    Command="{Binding DataContext.MuyuClickCommand,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayText}"
                                               FontSize="13"
                                               Foreground="{StaticResource BInkBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ElapsedText}"
                                               Margin="8,0,0,0"
                                               FontSize="11"
                                               Foreground="{StaticResource BMutedBrush}"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"/>
                                    <TextBlock Text="{Binding CostText}"
                                               Margin="6,0,0,0"
                                               FontSize="11"
                                               Foreground="{StaticResource BMutedBrush}"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- 免责 -->
            <Border Height="1" Background="{StaticResource BRuleBrush}" Margin="0,12,0,0"/>
            <TextBlock Text="节假日不计工资与加班费。计算结果仅供参考，以实际工资条为准。"
                       FontSize="11"
                       Foreground="{StaticResource BMutedBrush}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
