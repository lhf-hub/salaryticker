<!-- ============================================================================
     文件名：MiniWindow.xaml
     功能描述：迷你悬浮窗（无边框、置顶、可拖拽、透明度可调、位置记忆）
     暖阳浅色：白色半透明卡片 + 珊瑚描边 + 薄荷绿金额
     ============================================================================ -->
<Window x:Class="SalaryTicker.Views.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/SalaryTicker.ico"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SalaryTicker 迷你窗"
        Width="242" Height="96"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseDoubleClick="Window_MouseDoubleClick">

    <Border Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource PrimarySoftBrush}"
            BorderThickness="1.5"
            CornerRadius="20"
            Padding="14,10"
            Margin="6">
        <Border.Effect>
            <DropShadowEffect Color="{StaticResource ShadowColor}"
                              BlurRadius="20" ShadowDepth="4" Opacity="0.16"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题行：当前指标 + 切换 / 透明度 / 返回 -->
            <Grid Grid.Row="0">
                <TextBlock x:Name="MetricText"
                           Text="💰 本月已赚"
                           Style="{StaticResource TextSmall}"
                           VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Slider x:Name="OpacitySlider"
                            Width="36" Height="14"
                            Minimum="0.3" Maximum="1.0" Value="0.9"
                            ValueChanged="OpacitySlider_ValueChanged"
                            VerticalAlignment="Center"
                            ToolTip="调整透明度"/>
                    <Button Style="{StaticResource ButtonIcon}"
                            Click="SwitchMetric_Click"
                            Width="22" Height="22"
                            Margin="4,0,0,0"
                            ToolTip="切换显示内容：本月已赚 → 今日已赚 → 当前小时已赚">
                        <TextBlock Text="⇄" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Button>
                    <Button Style="{StaticResource ButtonIcon}"
                            Click="Return_Click"
                            Width="22" Height="22"
                            Margin="4,0,0,0"
                            ToolTip="返回主窗口（也可双击窗口）">
                        <TextBlock Text="↩" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 金额 -->
            <TextBlock Grid.Row="1"
                       x:Name="AmountText"
                       Text="¥0.00"
                       FontFamily="{StaticResource FontFamilyNumber}"
                       FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource MoneyBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <!-- 状态 -->
            <TextBlock Grid.Row="2"
                       x:Name="StatusText"
                       Text=""
                       Style="{StaticResource TextSmall}"
                       HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Border>
</Window>
