<!-- ============================================================================
     文件名：MiniWindow.xaml
     功能描述：迷你悬浮窗（无边框、置顶、可拖拽、透明度可调、位置记忆）
     Warm：暖白卡片、细边框、绿色读数、顶部四色短线
     ============================================================================ -->
<Window x:Class="SalaryTicker.Views.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/SalaryTicker.ico"
        Title="SalaryTicker 迷你窗"
        Width="242" Height="96"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseDoubleClick="Window_MouseDoubleClick"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style x:Key="MiniSlider" TargetType="Slider"
               BasedOn="{StaticResource WSliderStyle}"/>
    </Window.Resources>

    <Border Background="{StaticResource WGreenSoftBrush}"
            BorderBrush="#B6DCC9"
            BorderThickness="1"
            CornerRadius="12"
            Margin="6">
        <Border.Effect>
            <DropShadowEffect Color="#5A3C28"
                              BlurRadius="20" ShadowDepth="4" Opacity="0.14"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource WBrandGradientBrush}"
                    CornerRadius="12,12,0,0"/>

            <Grid Grid.Row="1" Margin="10,7,10,7">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题行：当前指标 + 切换 / 透明度 / 返回 -->
                <Grid Grid.Row="0">
                    <TextBlock x:Name="MetricText"
                               Text="本月已赚"
                               FontFamily="{StaticResource WFontBody}"
                               FontSize="11"
                               Foreground="{StaticResource WMutedBrush}"
                               VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Slider x:Name="OpacitySlider"
                                Style="{StaticResource MiniSlider}"
                                Width="36" Height="14"
                                Minimum="0.3" Maximum="1.0" Value="0.9"
                                ValueChanged="OpacitySlider_ValueChanged"
                                VerticalAlignment="Center"
                                ToolTip="调整透明度"/>
                        <Button Style="{StaticResource WTopButtonStyle}"
                                Click="SwitchMetric_Click"
                                Width="20" Height="20"
                                Padding="0"
                                Margin="4,0,0,0"
                                ToolTip="切换显示内容：本月已赚 → 今日已赚 → 当前小时已赚">
                            <TextBlock Text="⇄" FontSize="11"
                                       Foreground="{StaticResource WMutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource WTopButtonStyle}"
                                Click="Return_Click"
                                Width="20" Height="20"
                                Padding="0"
                                Margin="4,0,0,0"
                                ToolTip="返回主窗口（也可双击窗口）">
                            <TextBlock Text="↩" FontSize="11"
                                       Foreground="{StaticResource WMutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 金额 -->
                <TextBlock Grid.Row="1"
                           x:Name="AmountText"
                           Text="¥0.00"
                           FontFamily="{StaticResource WFontMono}"
                           FontSize="26" FontWeight="SemiBold"
                           Foreground="{StaticResource WGreenStrongBrush}"
                           Typography.NumeralAlignment="Tabular"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>

                <!-- 状态 -->
                <TextBlock Grid.Row="2"
                           x:Name="StatusText"
                           Text=""
                           FontFamily="{StaticResource WFontBody}"
                           FontSize="11"
                           Foreground="{StaticResource WSubtleBrush}"
                           HorizontalAlignment="Left"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Grid>
    </Border>
</Window>
