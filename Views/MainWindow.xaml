<!-- ============================================================================
     文件名：MainWindow.xaml
     功能描述：主窗口（顶部工具栏 + 页面切换：仪表盘/摸鱼历史）
     Warm 风格：奶油底 + 暖白卡片 + 四色短线 + 珊瑚/琥珀/薄荷语义色
     ============================================================================ -->
<Window x:Class="SalaryTicker.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/SalaryTicker.ico"
        xmlns:vm="clr-namespace:SalaryTicker.ViewModels"
        xmlns:pages="clr-namespace:SalaryTicker.Views.Pages"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        mc:Ignorable="d"
        Title="SalaryTicker - 实时计算器"
        Width="1180" Height="880"
        MinWidth="900" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WWindowBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════ 顶部工具栏 ══════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource WSurfaceBrush}"
                BorderBrush="{StaticResource WBrandGradientBrush}"
                BorderThickness="0,0,0,2"
                Padding="28,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：品牌与状态 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Image Source="/Assets/icon-preview-48.png"
                           Width="30" Height="30"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           VerticalAlignment="Center"/>
                    <TextBlock Text="SalaryTicker"
                               FontFamily="{StaticResource WFontDisplay}"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource WInkStrongBrush}"
                               VerticalAlignment="Center" Margin="9,0,0,0"/>
                    <TextBlock Text="实时计算器" FontSize="11"
                               Foreground="{StaticResource WMutedBrush}"
                               VerticalAlignment="Center" Margin="8,2,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                        <Ellipse Style="{StaticResource WStatusDotStyle}" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding StatusShortText}"
                                   FontSize="12"
                                   Foreground="{StaticResource WInkBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- 右侧：功能按钮 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource WTopButtonStyle}"
                            Command="{Binding ShowHistoryCommand}"
                            Margin="0,0,2,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconHistory}"
                                  Fill="{StaticResource WMutedBrush}"
                                  Width="16" Height="16" Stretch="Uniform"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="摸鱼统计" FontSize="13"
                                       Foreground="{StaticResource WInkBrush}"
                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource WTopButtonStyle}"
                            Command="{Binding ToggleMiniWindowCommand}"
                            Margin="0,0,2,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconMiniWindow}"
                                  Fill="{StaticResource WMutedBrush}"
                                  Width="16" Height="16" Stretch="Uniform"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="迷你窗" FontSize="13"
                                       Foreground="{StaticResource WInkBrush}"
                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource WTopButtonStyle}"
                            Command="{Binding OpenSettingsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconSettings}"
                                  Fill="{StaticResource WMutedBrush}"
                                  Width="16" Height="16" Stretch="Uniform"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="设置" FontSize="13"
                                       Foreground="{StaticResource WInkBrush}"
                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════ 提示条区（配置损坏 / 发现新版本） ══════════ -->
        <StackPanel Grid.Row="1">

            <!-- 配置损坏等提示 -->
            <Border Background="{StaticResource WarnSoftBrush}"
                    Padding="24,12"
                    Visibility="{Binding IsNoticeVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="⚠️" FontSize="15" VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               Text="{Binding NoticeText}"
                               Foreground="#8A5A2B"
                               Margin="10,0" TextWrapping="Wrap"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="2"
                            Style="{StaticResource ButtonIcon}"
                            Width="28" Height="28"
                            Command="{Binding DismissNoticeCommand}">
                        <TextBlock Text="✕" FontSize="12" Foreground="#8A5A2B"/>
                    </Button>
                </Grid>
            </Border>

            <!-- 位置小提示（仅在程序目录不可写时出现，可写时完全不打扰） -->
            <Border Background="{StaticResource BgSubtleBrush}"
                    Padding="24,12"
                    Visibility="{Binding Update.IsPortabilityNoticeVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding Update.PortabilityNoticeText}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="1"
                            Style="{StaticResource ButtonIcon}"
                            Width="28" Height="28"
                            Command="{Binding Update.DismissPortabilityNoticeCommand}">
                        <TextBlock Text="✕" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- 发现新版本 -->
            <Border Padding="24,12"
                    Visibility="{Binding Update.IsVisible, Converter={StaticResource BoolToVisibility}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Update.IsError}" Value="True">
                                <Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="🎉" FontSize="15" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Update.TitleText}"
                                   FontWeight="SemiBold" FontSize="14"
                                   Foreground="#8A4B38"/>
                        <TextBlock Text="{Binding Update.NotesText}"
                                   Style="{StaticResource TextSmall}"
                                   TextWrapping="Wrap" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding Update.StatusText}"
                                   Style="{StaticResource TextSmall}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,3,0,0"/>
                        <ProgressBar Value="{Binding Update.Progress, Mode=OneWay}"
                                     Minimum="0" Maximum="1"
                                     Height="6" Margin="0,6,0,0"
                                     Visibility="{Binding Update.IsDownloading, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>

                    <!-- 操作按钮（下载中隐藏） -->
                    <Button Grid.Column="2"
                            Content="立即更新"
                            Style="{StaticResource ButtonPrimary}"
                            Command="{Binding Update.StartUpdateCommand}"
                            Padding="18,7" Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding Update.ShowAutoUpdateButton, Converter={StaticResource BoolToVisibility}}"/>

                    <!-- 程序目录不可写时的兜底：引导到官网手动下载 -->
                    <Button Grid.Column="2"
                            Content="前往下载"
                            Style="{StaticResource ButtonPrimary}"
                            Command="{Binding Update.OpenDownloadPageCommand}"
                            Padding="18,7" Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding Update.ShowManualDownloadButton, Converter={StaticResource BoolToVisibility}}"/>

                    <Button Grid.Column="3"
                            Content="忽略此版本"
                            Style="{StaticResource ButtonGhost}"
                            Command="{Binding Update.SkipVersionCommand}"
                            Padding="14,7" Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding Update.IsDownloading, Converter={StaticResource InverseBoolToVisibility}}"/>

                    <Button Grid.Column="4"
                            Style="{StaticResource ButtonIcon}"
                            Width="28" Height="28"
                            VerticalAlignment="Center"
                            Command="{Binding Update.DismissCommand}">
                        <TextBlock Text="✕" FontSize="12" Foreground="#8A4B38"/>
                    </Button>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ══════════ 内容区：页面切换 ══════════ -->
        <ContentControl Grid.Row="2" Content="{Binding}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <pages:DashboardView/>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentView}" Value="MuyuHistory">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <pages:MuyuHistoryView DataContext="{Binding History}"/>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
    </Grid>
</Window>
