<!-- App.xaml —— 应用入口，合并全局资源字典（颜色/样式/控件/图标），不设 StartupUri，窗口流由代码编排 -->
<Application x:Class="SalaryTicker.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SalaryTicker.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 设计系统四层字典：Token → 全局样式 → 复合控件样式 → 图标 -->
                <ResourceDictionary Source="Resources/Colors.xaml"/>
                <ResourceDictionary Source="Resources/Styles.xaml"/>
                <ResourceDictionary Source="Resources/Controls.xaml"/>
                <ResourceDictionary Source="Resources/Icons.xaml"/>
                <!-- 实验：B 流水台账主题（只加 key，旧界面不受影响） -->
                <ResourceDictionary Source="Resources/BTheme.xaml"/>
                <!-- 实验：官网暖色高级版的 W 前缀 token（仅 Warm 对照窗使用） -->
                <ResourceDictionary Source="Resources/WarmTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 全局转换器 -->
            <conv:CurrencyConverter x:Key="Currency"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <conv:PercentConverter x:Key="Percent"/>
            <conv:IndexToVisibilityConverter x:Key="IndexToVisibility"/>
            <conv:IndexMinToVisibilityConverter x:Key="IndexMinToVisibility"/>
            <conv:InverseBoolConverter x:Key="InverseBool"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
