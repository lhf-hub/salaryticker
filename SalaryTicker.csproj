<!-- ShenzhenSalaryTimer.csproj —— 《深圳工资实时计算器》主工程文件 -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>SalaryTicker</AssemblyName>
    <RootNamespace>SalaryTicker</RootNamespace>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- 本机仅安装 .NET 10 桌面运行时，允许 net8.0 应用向上滚动运行 -->
    <RollForward>LatestMajor</RollForward>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 应用程序图标（exe 与任务栏） -->
    <ApplicationIcon>Assets\SalaryTicker.ico</ApplicationIcon>
    <!-- 关键：排除 tests 目录，防止测试工程源码被根目录通配编入主工程 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**</DefaultItemExcludes>
    <AssemblyTitle>SalaryTicker 实时计算器</AssemblyTitle>
    <Product>SalaryTicker</Product>
    <Company>Lee老师</Company>
    <Version>1.1.6</Version>
    <!-- 显式声明，保证更新比对与发布脚本读取到的版本号稳定 -->
    <AssemblyVersion>1.1.6.0</AssemblyVersion>
    <FileVersion>1.1.6.0</FileVersion>
    <InformationalVersion>1.1.6</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- 唯一 NuGet 依赖：MVVM 工具包（需求书指定） -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 图标资源：窗口 Icon 属性引用（pack URI） -->
    <Resource Include="Assets\SalaryTicker.ico" />
  </ItemGroup>

</Project>
